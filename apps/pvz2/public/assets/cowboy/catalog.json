cowboy/audio/e2651a8d-fa65-499b-9211-56d7c4b1dde7.mp3","cowboy/audio/13150ea5-c742-47d9-a6c9-c38b1d532aa3.mp3","cowboy/audio/f0b8c475-13fc-4c2c-b11c-faa9523ab7b6.mp3","cowboy/audio/9f062aec-8464-4b73-bdc2-696c48d54b79.mp3","cowboy/audio/d3064974-a87d-419b-9267-fc1a3d5634e9.mp3","cowboy/audio/578313b7-da5c-448d-8d3d-e3b7a7c0e3c0.mp3","cowboy/audio/142c8a07-8677-41fa-ab72-3cf19ef7b4ae.mp3","cowboy/audio/48d3b1c4-1bae-4bbf-92be-a5186f434b15.mp3"],"crazydave/Playful_Short":["cowboy/audio/782351fd-4ea7-4356-b6e9-50187b92c14f.mp3","cowboy/audio/4ee34818-438f-46b8-9d4b-11d6ee31c124.mp3","cowboy/audio/c1c00325-7e0a-4c3a-9636-f12c3bce03e7.mp3"],"crazydave/Say_Short":["cowboy/audio/450cb5a3-c611-477f-b23d-79530b9a9dca.mp3","cowboy/audio/290ea528-a181-4681-81ac-8fb36b9c2e7a.mp3","cowboy/audio/4714dddf-7279-41fa-8808-dc1fdacbc677.mp3","cowboy/audio/0b0454f6-e4c3-4769-8f59-5a9c0221564a.mp3","cowboy/audio/baca6ff3-f0e9-4c3b-9823-9c7d89fcd8d1.mp3","cowboy/audio/27a7c8ee-cc8f-4ff1-bfef-5a34f3920d00.mp3","cowboy/audio/8329fffd-8d13-4de7-9a3f-f00f1b1a2175.mp3"]},"narratives":{"COWBOY_CHALLENGE_PROTECTPLANTS_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"These levels can be tough nuts to crack.","zh":"这些关卡就像硬核桃一样难以破解。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"And I want to see the delicious creamy center.","zh":"而且我喜欢那种甜美的软糯的核桃果肉。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"The point is not to crack them.","zh":"前提是眼前的核桃不被砸坏。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"COWBOY_INTRO_FIRSTLEVEL":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Six shooters:\nlocked and loaded","zh":"六个弹膛：\n填充完毕"},"Animation":"Say_Small","Voice":"winnie/Say_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Old timey piano music:\ndownloaded","zh":"老钢琴曲：\n下载完毕"},"Animation":"Say_Small","Voice":"winnie/Say_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Chance of taco:\n0.015%","zh":"遇到玉米卷的概率：\n0.015%"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Margin of error:\n0.016%","zh":"误差范围：\n0.016%"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"COWBOY_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"My Uncle Milo used to have one these, he called it a boom box.","zh":"我的叔叔以前用过这样的东西，他说这是轰隆盒。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Actually, that's close enough. I'll allow it.","zh":"事实上，这很接近了，无需纠正。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}],"COWBOY_CHALLENGE_LASTSTAND_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It's high noon, and waves of zombies about.","zh":"正午了，僵尸们如潮水般涌来。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Time to show them who's got the fastest plants in time!","zh":"该让他们见识一下谁才是植物界里的快枪手了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"COWBOY_INTRO_LEVEL7":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Like cow tipping, zombie tipping is best done from the side.","zh":"就像推倒奶牛一样，推倒僵尸也建议从侧方下手。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Trust me, do not try and tip a cow from behind!","zh":"相信我，千万别从尝试从后面推倒一头奶牛！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"COWBOY_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Greetings Plant Rustler,","zh":"你好啊，老园丁！"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Agents are arriving to mark your brains as my property.","zh":"我派来了特务，专门给你的脑子的所有权标记给我。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Salutations, Dr. Edgar Zomboss.","zh":"敬礼！埃德加·僵尸博士"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I don't want my brains all marked up.","zh":"我可不想让我的脑子有个烫痕。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"It took forever to get 'em clean.","zh":"那样的话我会一辈子洗不掉这个印记的。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"COWBOY_OUTRO_GARGANTUAR":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Maybe we can use that to unlock our minds.","zh":"或许我们可以用这玩意解放我们的思维。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"I still have some cleaning to do.","zh":"但我还有清洗工作要做。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It would be better used gaining access to a World.","zh":"把它用在前往其他时空是个更好的主意。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"You know, for the greater good of...","zh":"你懂的，这都是为了……"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"The Taco! I almost forgot.","zh":"是为了玉米卷！我差点忘了。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"COWBOY_CHALLENGE_PRESET_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"These plants are mine!","zh":"这些植物简直是宝矿！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"Well not mine... yours.","zh":"不是说它们吸取矿物质……是指它们是……宝矿。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"They're for the mine...","zh":"总之把它们放在矿……"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"...carts.","zh":"……车上吧。"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}]},"ui":{"note-cowboy":{"image":"cowboy/ui/e62711a6-eb68-4002-8117-d87acbe05ed1_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"cowboy"}}}
