r":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"These trained zombies don't seem thirsty for brains.","zh":"这些经过训练的僵尸似乎并不渴求脑子。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"They're likely aiming at our aerial fortress.","zh":"他们似乎瞄准了我们的飞行堡垒。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"They are not gonna make it.","zh":"那可不能放任他们。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"May we have good luck, Neighbor.","zh":"祝我们好运，邻居。"},"Animation":"Say_Small","Voice":"winnie/Say_Short"}],"SKYCITY_2_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"The special bullets from Skyshooters create air currents within a small area.","zh":"飞天射手发射的特殊子弹会产生局部气流。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Though it's not strong enough to blow zombies away like Blover does.","zh":"虽然不足以像三叶草那样把僵尸吹到场外。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"However, it can hinder the zombies' movements.","zh":"不过可以牵制僵尸的行动。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Be confident for their participation.","zh":"相信他的加入会起到大作用的。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"And, of course, they can fly.","zh":"哦，当然，他还可以飞。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Alert! Enemy Drop Ships detected!","zh":"警报，检测到敌方运兵艇正在靠近！"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Watch your back.","zh":"小心背后。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"}],"SKYCITY_3_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Speaking of aerial combat, how could there be no guns or bullets?","zh":"说起空战，怎么能没有战机呢。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Next, let's welcome our aerial combat ace...","zh":"接下来有请我们的空战王牌……"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"SHOUT","Lines":{"en":"The Asparagus!","zh":"芦笋战机！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Have fun with them.","zh":"玩得开心。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"}],"SKYCITY_5_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The battle planes heavily damaged our ship.","zh":"战斗机重创了我们的飞船。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Though we've finished repairing,","zh":"虽然修复工作已经完成，"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"But I don't think we have the capability to survive from further attack.","zh":"但我不认为我们有能力挺过再一轮攻击。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"About time to bring out my treasured Pineapple, ...","zh":"这时候就要拿出我珍藏的旋转菠萝了。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"...which can reflect the projectiles from our enemies.","zh":"他可以反弹对面打来的子弹。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"...","zh":"……"},"Animation":"Say_Small","Voice":"winnie/Say_Short"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Treasured, huh?","zh":"珍藏，是吗？"},"Animation":"Say_Small","Voice":"winnie/Playful_Short"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Look at those clouds! They look like...","zh":"看这些云，看起来很像……"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"...clouds.","zh":"……云。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"}]},"ui":{}}
