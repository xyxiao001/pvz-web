/14a64675-1372-4242-80bf-a8da2a326ba7.mp3","dark/audio/da5d4184-c1b2-4e77-a24c-18e74d2a90ac.mp3","dark/audio/0a02fad7-4b96-4ce8-a15b-e52a2adae29f.mp3","dark/audio/037943b0-db96-4e06-a8f9-378497015f66.mp3","dark/audio/a6c091ae-699c-4cef-89c5-aff23bbb7107.mp3"],"zombossicon/Say_Short":["dark/audio/a864329c-2b29-4111-b715-958f568a69f9.mp3","dark/audio/72e5cbf7-0148-45be-b2cb-c5fae8f725bb.mp3"],"zombossicon/Say_Long":["dark/audio/519753c6-6d42-41cf-acdf-9df6e8c15d01.mp3","dark/audio/e3aa0ce3-4771-464a-8e95-dc89529aa792.mp3","dark/audio/aaef7c4b-1d6b-4ae5-ba93-795a06b5e1cf.mp3","dark/audio/757f97cc-05cc-4d82-9775-a62892ebe0af.mp3"],"zombossicon/Say_Med":["dark/audio/dbc24b85-aea4-44c1-bd70-29f0e79a6cde.mp3","dark/audio/16c498f2-e40f-49ef-bffc-3f2623a0f6a8.mp3","dark/audio/6b4a7259-035b-42b9-9d89-bdab5cfbcdef.mp3","dark/audio/9fa63ae2-17bf-4aec-a693-f21946100110.mp3"]},"narratives":{"DARK_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Whoa there! Who dimmed the lights?","zh":"喂喂！谁把灯熄了？"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"No one, User Dave. We have simply arrived in the Dark Ages.","zh":"没人关了灯，用户戴夫。我们只是到了黑暗时代。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Sounds gloomy to me.","zh":"听起来很黑暗。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Indeed. According to my research, a plague has swept this era.","zh":"当然。根据我的调查，瘟疫席卷了这个时代。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Also, sun no longer falls from the sky.","zh":"还有，太阳不会再从天上掉下来了。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"What we need is someone to brighten this place up!","zh":"我们需要的是有人来照亮这个地方！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I got it! We need Sun-shrooms!","zh":"我知道了！我们需要阳光菇！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"These guys not only know how to turn a frown upside down...","zh":"这些小家伙们不仅知道如何让人眉开眼笑……"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"They make more sun as they grow! Great guys, very talented.","zh":"随着他们的成长，他们会产出更多的太阳！真是了不起的家伙，太有才华了。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DARK_INTRO_FUMESHROOM":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"I'm afraid the Dark Ages are giving me a bad case of the vapours.","zh":"黑暗时代的雾气病毒会让我有些神志不清。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"User Dave, the vapours are no longer considered a real ailment.","zh":"用户戴夫，雾气不是病毒。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"But I believe Fume-shroom will be of use here.","zh":"但我相信大喷菇的雾气确实有毒性。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"His vapors are quite real and provide a distinct advantage against the right zombie opponents.","zh":"他的雾气非常真实，在面对个别僵尸时非常有优势。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Fume-tastic! Let's give the zombies a case of the vapours instead!","zh":"雾哦！让我们给僵尸们来一发喷雾吧！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DARK_INTRO_HYPNOSHROOM":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Data suggests the Dark Ages were a time of intellectual decline and moral  confusion.","zh":"资料显示，黑暗时代是一个智力衰退、道德混乱的时代。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Perhaps now is a good time to call upon the persuasive powers of the Hypno-shroom?","zh":"或许这正好是魅惑菇大展身手的好时机？"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Good idea, Penny! We'll convert the wicked – Dark Ages style!","zh":"好主意，潘妮！我们将化解邪恶——用黑暗时代的特色！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Deploy this shroom and the zombies won't know what bit them...","zh":"种下这只蘑菇，僵尸绝对不会猜到自己将会被谁啃咬……"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Fume-tastic! Let's give the zombies a case of the vapours instead!","zh":"雾哦！让我们给僵尸们来一发喷雾吧！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DARK_INTRO_EVILPOTIONS":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Warning! I've detected carafes containing chemical compounds of a malevolent makeup!","zh":"警告！我已检测到以邪恶为配方的药瓶！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"Can you translate that into Crazy Dave Talk for me?","zh":"你就不能以我能听懂的口吻告诉我吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"There are evil potions on the lawn!","zh":"你的前院冒出了邪恶药水！"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Evil medieval potions! They're the most dangerous kind...","zh":"邪恶的中世纪药剂！而且是最危险的那一类……"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"On account of having twice the evil!","zh":"因为它们能让邪恶翻倍！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"DARK_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Methinks the siphoning of thine brains is the only way to correct this ailment!","zh":"幸会，非贵族大人！"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"It is my fervent medical opinion that your humours are out of balance!","zh":"我十分地确信，你的内环境失去了平衡！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Methinks the siphoning of thine brains is the only way to correct this ailment!","zh":"我认为，对你的大脑进行虹吸疗程是解决这种疾病的唯一办法！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Fare thee ill, Dr. Edgar Zomboss","zh":"一路走好。埃德加·僵尸博士"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Hey! I prefer my humors and my brains unbalanced!","zh":"嘿！我确实觉得我体液过热，讲不出冷笑话了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Because I'm CRAAAAZY!","zh":"因为我已经疯了！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}]},"ui":{"note-dark":{"image":"dark/ui/d7bb80c8-265f-48c2-aa61-2472aadcd476_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"dark"}}}
