44-e39a-420e-bf27-2c4c8b547e3f.mp3","dark/audio/65b024a9-23ee-4691-8c76-063cedbfcf88.mp3","dark/audio/5c559a5a-fdfd-4a38-91fd-2eb1311d86d6.mp3","dark/audio/16be66ad-bc61-4b18-acfc-f5e79bd3ea6e.mp3","dark/audio/0b9b0617-6056-424d-bf7c-72ae803cf50c.mp3","dark/audio/216b7246-ad46-4eab-948a-0207d11fced2.mp3","dark/audio/7f6a3d77-284e-4741-b1bd-8dc9239bff74.mp3","dark/audio/4be09f32-ef6b-4be5-b132-335d1c72c4c9.mp3","dark/audio/e87b43dd-3fae-44d9-b9ba-1f8eff03ed23.mp3","dark/audio/54afe536-9002-435a-b633-f31e583206c3.mp3","dark/audio/2f63afcc-42ee-4c36-8ac5-817ce26db34b.mp3","dark/audio/134ca1b8-ae87-4343-a5a5-748b757a50be.mp3","dark/audio/059f10bb-9721-4912-9326-bc350c4d4122.mp3","dark/audio/6dd11699-f1c1-42a2-9c9f-05801a763323.mp3","dark/audio/49a97d41-9a33-446c-b097-3a011286d006.mp3","dark/audio/78495e3a-412d-4394-b768-d547bae1ed53.mp3","dark/audio/6ea0f851-abae-4f59-aeea-0b52a961ba12.mp3"]},"narratives":{"DARK_INTRO_MAGNETSHROOM":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"According to my data, iron and other metals were routinely put to use during the Dark Ages.","zh":"我的数据表明，铁等金属在中世纪黑暗时期已被投入例行使用。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Thus, Magnet-shroom should make an excellent ally here.","zh":"因此，磁力菇在这会成为一个好伙伴。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"He can pull buckets, helmets and other metal objects off of zombies!","zh":"他可以吸走僵尸身上的铁桶，头盔和其他金属物品！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Some people think it's magic. But really, it's just physics.","zh":"有些人认为这是魔法，但其实，这只是物理。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DARK_INTRO_ZOMBOSS":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"A question for you, my Ignoble Foes!","zh":"有个问题要问你们，我卑劣的敌人们！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Hast thou noted how violent thine plants become upon consuming Plant Food?","zh":"阁下可曾注意，你们的植物在享用叶绿素后变得多么暴力？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Perchance, hast thou wondered what Plant Food is truly made of?","zh":"不知，阁下可曾思索过，那叶绿素究竟是何物制成？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Verily, I shall tell thee. It's zombies! Plant food is made out of zombies!","zh":"诚然，我当告知阁下。是僵尸！叶绿素是僵尸制成的！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Unpossible! We feed our plants only the highest quality organic uhm...","zh":"不可能！我们的植物只吃最顶级的有机……呃……"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"Hey Penny, what is Plant Food made of?","zh":"嘿！潘妮，叶绿素是什么做的？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I fear the true nature of Plant Food requires further analysis, User Dave.","zh":"用户戴夫，我认为叶绿素的本质恐怕还需要进一步分析。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Excuse me while I run some tests.","zh":"失陪一下，我需要去做一些测试。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"DARK_OUTRO_ZOMBOSS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I have found no evidence that Plant Food contains zombies or zombie byproducts.","zh":"我没有找到任何叶绿素包含僵尸或其衍生物的证据。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"Phew! Plants shouldn't eat zombies who eat plants.","zh":"幸好！植物不该吃那些会吃植物的僵尸。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Except Chomper. He has to. Dude needs the fiber.","zh":"除了大嘴花，它得吃。它得摄入一些纤维。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Why dost thine time-traveling jalopy lie to thee?","zh":"那台能穿梭时光的破车，为什么欺骗阁下？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Perchance, a question best left for another day?","zh":"要不，这个问题暂且留待他日？"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Now, I pray, imagine maniacal laughter as I depart.","zh":"此刻，我请您在脑海中想象我离去时发出的猖狂笑声。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}],"DARK_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Whoa there! Who dimmed the lights?","zh":"喂喂！谁把灯熄了？"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"No one, User Dave. We have simply arrived in the Dark Ages.","zh":"没人关了灯，用户戴夫。我们只是到了黑暗时代。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Sounds gloomy to me.","zh":"听起来很黑暗。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Indeed. According to my research, a plague has swept this era.","zh":"当然。根据我的调查，瘟疫席卷了这个时代。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Also, sun no longer falls from the sky.","zh":"还有，太阳不会再从天上掉下来了。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"What we need is someone to brighten this place up!","zh":"我们需要的是有人来照亮这个地方！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I got it! We need Sun-shrooms!","zh":"我知道了！我们需要阳光菇！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"These guys not only know how to turn a frown upside down...","zh":"这些小家伙们不仅知道如何让人眉开眼笑……"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"They make more sun as they grow! Great guys, very talented.","zh":"随着他们的成长，他们会产出更多的太阳！真是了不起的家伙，太有才华了。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DARK_INTRO_FUMESHROOM":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"I'm afraid the Dark Ages are giving me a bad case of the vapours.","zh":"黑暗时代的雾气病毒会让我有些神志不清。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"User Dave, the vapours are no longer considered a real ailment.","zh":"用户戴夫，雾气不是病毒。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"But I believe Fume-shroom will be of use here.","zh":"但我相信大喷菇的雾气确实有毒性。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"His vapors are quite real and provide a distinct advantage against the right zombie opponents.","zh":"他的雾气非常真实，在面对个别僵尸时非常有优势。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Fume-tastic! Let's give the zombies a case of the vapours instead!","zh":"雾哦！让我们给僵尸们来一发喷雾吧！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DARK_INTRO_HYPNOSHROOM":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Data suggests the Dark Ages were a time of intellectual decline and moral  confusion.","zh":"资料显示，黑暗时代是一个智力衰退、道德混乱的时代。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Perhaps now is a good time to call upon the persuasive powers of the Hypno-shroom?","zh":"或许这正好是魅惑菇大展身手的好时机？"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Good idea, Penny! We'll convert the wicked – Dark Ages style!","zh":"好主意，潘妮！我们将化解邪恶——用黑暗时代的特色！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Deploy this shroom and the zombies won't know what bit them...","zh":"种下这只蘑菇，僵尸绝对不会猜到自己将会被谁啃咬……"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Fume-tastic! Let's give the zombies a case of the vapours instead!","zh":"雾哦！让我们给僵尸们来一发喷雾吧！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DARK_INTRO_EVILPOTIONS":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Warning! I've detected carafes containing chemical compounds of a malevolent makeup!","zh":"警告！我已检测到以邪恶为配方的药瓶！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"Can you translate that into Crazy Dave Talk for me?","zh":"你就不能以我能听懂的口吻告诉我吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"There are evil potions on the lawn!","zh":"你的前院冒出了邪恶药水！"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Evil medieval potions! They're the most dangerous kind...","zh":"邪恶的中世纪药剂！而且是最危险的那一类……"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"On account of having twice the evil!","zh":"因为它们能让邪恶翻倍！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"DARK_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Methinks the siphoning of thine brains is the only way to correct this ailment!","zh":"幸会，非贵族大人！"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"It is my fervent medical opinion that your humours are out of balance!","zh":"我十分地确信，你的内环境失去了平衡！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Methinks the siphoning of thine brains is the only way to correct this ailment!","zh":"我认为，对你的大脑进行虹吸疗程是解决这种疾病的唯一办法！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Fare thee ill, Dr. Edgar Zomboss","zh":"一路走好。埃德加·僵尸博士"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Hey! I prefer my humors and my brains unbalanced!","zh":"嘿！我确实觉得我体液过热，讲不出冷笑话了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Because I'm CRAAAAZY!","zh":"因为我已经疯了！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"DARK_INTRO_PEANUT":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Boy, Pea-shooter and Wall-nut sure are good at what they do.","zh":"嘿，豌豆射手和坚果墙还真是各显神通啊。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Talk about two great plants that fight great together!","zh":"这才叫黄金搭档！两株植物要是能合成一下一起对抗僵尸该多好！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"User Dave! Perhaps you are not as cerebrally unsound as you periodically insist!","zh":"用户戴夫！或许您并非如您时常宣称的那般……呃……脑回路清奇！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"What if there was one plant that behaved like both a Pea-shooter AND a Wall-nut?","zh":"要是有一株植物，既能像豌豆射手那样发射豌豆，又能像坚果墙一样挡住僵尸会怎样？"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We would call it a ... Pea-nut!","zh":"我们能称之为……“花生（Pea-nut）”！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Two plant powers in one legume's body?","zh":"一株植物驾驭两种植物的力量？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Keep talkin' like that and people are going to call you Crazy Penny!","zh":"一定要继续这样想象，这样大家都会叫你“疯狂潘妮”！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Which would be weird for both of us.","zh":"虽然对我们俩来说太奇怪了。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"DARK_OUTRO_DANGER_ROOM_KEY":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Why would anyone go and stick a nice sword into a dirty ol' rock?","zh":"怎么会有人把一把好端端的剑插进一块脏兮兮的破石头里？"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"I understand it to be a test, User Dave.","zh":"据我所知，这是一种试炼，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Only someone with great physical strength and strength of character may remove it.","zh":"唯有兼具非凡膂力与崇高品格之人，方能将其拔出。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I bet someone with a jackhammer could remove it.","zh":"我看拿个电钻来准能把它弄出来。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"A CRAAAZY someone!","zh":"当然要以最最最疯狂的方式！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"An inelegant but no doubt effective solution to the test, User Dave.","zh":"虽不优雅，但无疑是破解试炼的有效方案，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}]},"ui":{"note-dark":{"image":"dark/ui/d7bb80c8-265f-48c2-aa61-2472aadcd476_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"dark"}}}
