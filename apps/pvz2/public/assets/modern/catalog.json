e":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We have arrived moments before our departure!","zh":"我们到达了我们出发前的时间点。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"If my guess is correct, Dr. Zomboss will attempt to prevent your initial taco-consumption!","zh":"若我猜测正确，僵尸博士将试图阻止你吃下最开始那个玉米卷！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Our journeys will cease to exist!","zh":"我们的旅程将不复存在！"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"NOOOOOOOOOO!","zh":"不！！！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"...OOOOOOOO! Sorry, I was busy screaming \"No.\" Did you say \"taco\"?","zh":"不…………不好意思，我刚刚忙着大喊”不“呢，你刚刚是说”玉米卷“吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We must beware, User Dave. Dr. Zomboss will surely deploy all his time-varied zombies against us!","zh":"我们必须警惕，用户戴夫。僵尸博士一定会派遣来自所有时空的不同僵尸攻击我们！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"TACOOOOOOO!!!","zh":"玉米卷！！！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_2_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Moonflower emits sun, User Dave. But that is not all.","zh":"月光花会生产阳光，用户戴夫。但是还不止于此。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My scans show that it creates a special glow that augments plants of its type.","zh":"我的扫描显示它会产生特殊光芒，增强同类型的植物。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Planting Moonflowers next to each other should increase their power.","zh":"把月光花种在一起会增强它们的力量。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I suspect they will have the same effect on any other shadow plants we may find. ","zh":"我推测它们对我们可能找到的其他暗影植物会产生同样效果。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"TACOOOOOOOO!!!","zh":"玉米卷！！！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_3_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Shrinking Violet is well named, User Dave. ","zh":"畏缩紫罗兰名副其实，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It shrinks zombies and makes them weaker.","zh":"它能使僵尸缩小并削弱其力量。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Tiny zombies! Stay away from my shins!","zh":"迷你僵尸！离我的小腿远点！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"MODERN_5_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Nightshade is another shadow plant, User Dave.","zh":"暗影龙葵是另一种暗影植物，用户戴夫"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"By itself it deals slapping damage to zombies.","zh":"单独作战时，它能对僵尸造成近战伤害。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"But if it is planted next a Moonflower, both will become more powerful.","zh":"但若将其种植在月光花旁，两者都会变得更强大。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Botanical buddies? That's CRAAA-ZY!","zh":"植物好伙伴？这太疯——狂了！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"BEGHOULED_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I am picking up a grid of plants, User Dave.","zh":"我正在接收一个植物方阵的布局数据，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My scans suggest that they can be swapped to create matches of three.","zh":"我的扫描结果显示，这些植物可以通过交换位置形成三连匹配。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I saw a game like that once on my telephoney!","zh":"我好像以前在我的小手机上见过类似的游戏！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"You can use sun to upgrade the plants.","zh":"你可以用阳光能量来升级植物。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Make 100 matches to defeat the zombies!","zh":"完成 100 次匹配即可击败僵尸！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"MODERN_9_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My sensors are picking up increased helium levels, User Dave.","zh":"我的传感器检测到氦气浓度正在上升，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I suspect we may be facing one or more Balloon Zombies.","zh":"我推测我们可能面临一个或多个气球僵尸的威胁。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I hate one or more Balloon Zombies!","zh":"我讨厌一个或多个气球僵尸！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}]},"ui":{}}
