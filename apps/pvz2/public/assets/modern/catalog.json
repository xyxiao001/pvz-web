"modern/audio/e87b43dd-3fae-44d9-b9ba-1f8eff03ed23.mp3","modern/audio/54afe536-9002-435a-b633-f31e583206c3.mp3","modern/audio/2f63afcc-42ee-4c36-8ac5-817ce26db34b.mp3","modern/audio/134ca1b8-ae87-4343-a5a5-748b757a50be.mp3","modern/audio/059f10bb-9721-4912-9326-bc350c4d4122.mp3","modern/audio/6dd11699-f1c1-42a2-9c9f-05801a763323.mp3","modern/audio/49a97d41-9a33-446c-b097-3a011286d006.mp3","modern/audio/78495e3a-412d-4394-b768-d547bae1ed53.mp3","modern/audio/6ea0f851-abae-4f59-aeea-0b52a961ba12.mp3"],"crazydave/Say_Short":["modern/audio/450cb5a3-c611-477f-b23d-79530b9a9dca.mp3","modern/audio/290ea528-a181-4681-81ac-8fb36b9c2e7a.mp3","modern/audio/4714dddf-7279-41fa-8808-dc1fdacbc677.mp3","modern/audio/0b0454f6-e4c3-4769-8f59-5a9c0221564a.mp3","modern/audio/baca6ff3-f0e9-4c3b-9823-9c7d89fcd8d1.mp3","modern/audio/27a7c8ee-cc8f-4ff1-bfef-5a34f3920d00.mp3","modern/audio/8329fffd-8d13-4de7-9a3f-f00f1b1a2175.mp3"]},"narratives":{"MODERN_1_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Aha! Project Paradox begins... NOW!","zh":"啊哈！悖论计划现在……启动！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Timeline alert, User Dave!","zh":"时间线警报，用户戴夫！"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We have arrived moments before our departure!","zh":"我们到达了我们出发前的时间点。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"If my guess is correct, Dr. Zomboss will attempt to prevent your initial taco-consumption!","zh":"若我猜测正确，僵尸博士将试图阻止你吃下最开始那个玉米卷！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Our journeys will cease to exist!","zh":"我们的旅程将不复存在！"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"NOOOOOOOOOO!","zh":"不！！！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"...OOOOOOOO! Sorry, I was busy screaming \"No.\" Did you say \"taco\"?","zh":"不…………不好意思，我刚刚忙着大喊”不“呢，你刚刚是说”玉米卷“吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We must beware, User Dave. Dr. Zomboss will surely deploy all his time-varied zombies against us!","zh":"我们必须警惕，用户戴夫。僵尸博士一定会派遣来自所有时空的不同僵尸攻击我们！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"TACOOOOOOO!!!","zh":"玉米卷！！！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_2_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Moonflower emits sun, User Dave. But that is not all.","zh":"月光花会生产阳光，用户戴夫。但是还不止于此。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My scans show that it creates a special glow that augments plants of its type.","zh":"我的扫描显示它会产生特殊光芒，增强同类型的植物。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Planting Moonflowers next to each other should increase their power.","zh":"把月光花种在一起会增强它们的力量。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I suspect they will have the same effect on any other shadow plants we may find. ","zh":"我推测它们对我们可能找到的其他暗影植物会产生同样效果。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"TACOOOOOOOO!!!","zh":"玉米卷！！！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_3_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Shrinking Violet is well named, User Dave. ","zh":"畏缩紫罗兰名副其实，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It shrinks zombies and makes them weaker.","zh":"它能使僵尸缩小并削弱其力量。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Tiny zombies! Stay away from my shins!","zh":"迷你僵尸！离我的小腿远点！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"MODERN_5_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Nightshade is another shadow plant, User Dave.","zh":"暗影龙葵是另一种暗影植物，用户戴夫"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"By itself it deals slapping damage to zombies.","zh":"单独作战时，它能对僵尸造成近战伤害。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"But if it is planted next a Moonflower, both will become more powerful.","zh":"但若将其种植在月光花旁，两者都会变得更强大。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Botanical buddies? That's CRAAA-ZY!","zh":"植物好伙伴？这太疯——狂了！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"BEGHOULED_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I am picking up a grid of plants, User Dave.","zh":"我正在接收一个植物方阵的布局数据，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My scans suggest that they can be swapped to create matches of three.","zh":"我的扫描结果显示，这些植物可以通过交换位置形成三连匹配。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I saw a game like that once on my telephoney!","zh":"我好像以前在我的小手机上见过类似的游戏！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"You can use sun to upgrade the plants.","zh":"你可以用阳光能量来升级植物。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Make 100 matches to defeat the zombies!","zh":"完成 100 次匹配即可击败僵尸！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"MODERN_9_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My sensors are picking up increased helium levels, User Dave.","zh":"我的传感器检测到氦气浓度正在上升，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I suspect we may be facing one or more Balloon Zombies.","zh":"我推测我们可能面临一个或多个气球僵尸的威胁。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I hate one or more Balloon Zombies!","zh":"我讨厌一个或多个气球僵尸！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"MODERN_11_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We have picked up a Shadow-shroom seed packet, User Dave. ","zh":"我们捡起了一包毒影菇的种子，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":" Shadow-shrooms are shadow plants, so be sure to plant them next to Moonflowers for bonus effects.","zh":"毒影菇是暗影植物，所以请确保它们种在月光花边上以获取增益效果。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":" Adjacency wins again!","zh":"相邻效应再次获胜！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_15_OUTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":" Look, Penny! MY TACO! ","zh":"瞧啊，潘妮！我的玉米卷！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"No, User Dave! You must not! I detect high levels of trappiness!","zh":"不，用户戴夫！千万不行！检测到高度陷阱风险！！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"But... HUNGY... CHOW... TACO!","zh":"但是……饿……饭……玉米卷！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"MODERN_16_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Fools! You have fallen into my excruciatingly obvious trap!","zh":"一群蠢货！你们已落入我显而易见的陷阱里了！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":" My vast and varied array of Gargantuars will pummel you into total oblivion!","zh":"我庞大又多样化的巨尸军团将把你们捶至彻底湮灭！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"And then I get my taco?","zh":"然后我能吃到我的玉米卷？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"MODERN_17_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Dusk Lobber is yet another shadow plant, User Dave.","zh":"幽暮投手是另一种暗影植物，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"On its own, it lobs exploding projectiles.","zh":"单独作战时，它会投掷爆炸性抛射物。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"In its powered state, however, it lobs down three lanes!","zh":"但在暗影状态下，它能同时攻击三行草坪的敌人！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"That's a lane for each of my thumbs and noses!","zh":"正好我有两根拇指和一个鼻子！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"MODERN_19_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Escape Root is a tricky plant, User Dave.","zh":"逃脱树根是株诡诈的植物，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"When threatened, it swaps in an explosive plant!","zh":"受到威胁时，它会变身为一株爆炸植物！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"And if you tap it, and then another plant, they will switch places!","zh":"若你点击它，再点另一株植物，它们就会互换位置！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"You can use Escape Roots to rescue endangered plants!","zh":"你可以用逃脱树根来拯救濒临危险的植物！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Whaaaaa-? Plants can be in-dangered? CALL THE POLICE!","zh":"什什什么——？植物也会濒危？快报警！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"MODERN_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Penny! A random length of sewer pipe!","zh":"潘妮！一截不知哪儿来的下水管道！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Be careful, User Dave. That pipe is part of a municipal mulch of endless engagement!","zh":"小心，用户戴夫。那管道是市政无尽挑战体系的一部分！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"MODERN_21_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"All-Star Zombies are encroaching, User Dave!","zh":"全明星僵尸正在逼近，用户戴夫！"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"They tackle and destroy the first plant they encounter!","zh":"它们会踹倒并摧毁遇到的第一株植物！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I blame the ref!","zh":"都怪裁判！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_22_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Oy howdy! I think it's one of those Beghouled-y grids again, Penny!","zh":"哎哟喂！潘妮，我觉得又是那种宝石迷阵式的格子了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"MODERN_23_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Grimrose is a shadow plant, User Dave.","zh":"暗樱草属于暗影植物，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It drags down a zombie that enters its lane.","zh":"它会拖拽进入其所在行的僵尸。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"When powered, it can dispose of three zombies before it expires.","zh":"在暗影状态下，它能在消失前处理掉三只僵尸。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"That just seems like it's trying too hard!","zh":"这似乎有点用力过猛了！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"MODERN_24_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I hear tiny feet! They're pitter-pattering!","zh":"我听到小脚丫的声音！正啪嗒啪嗒响呢！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Engage caution, User Dave. I detect Super-fan Imps ahead!","zh":"谨慎行动，用户戴夫。检测到前方有狂热粉丝小鬼！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Their team spirit is explosive!","zh":"它们的团队精神简直爆表！"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}],"MODERN_32_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"It is presently a moment of your apocalypse!","zh":"此刻正是你的末日时刻！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Your reckless pursuit of an already-eaten taco has shattered all of time!","zh":"你那对玉米卷不计代价的追求已经粉碎了所有时间线！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"It falls to me to restore future, now, and past!","zh":"重整未来、现在与过去的责任，落到我肩上了！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":" Can it be true, User Dave?","zh":"这难道是真的吗，用户戴夫？"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Has our quest ruptured the timestream itself?","zh":"难道我们的追寻本身撕裂了时间流？"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Allow me to address your concern thusly:","zh":"让我来回应你的担忧吧："},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"*ahem*","zh":"*咳咳*"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"TACOOOOOOO!!!!!","zh":"玉米卷！！！！！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_32_OUTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Fools! Do you not value the validity of time?","zh":"蠢材！难道你们不重视时间的合理性吗？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Care you not if one moment follows another?","zh":"难道你们不在意时间的相继有序？"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Moron! Ignoramus! Pot-wearer!","zh":"蠢货！无知之徒！臭戴锅的！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":" It's not a pot, it's a handled basin!","zh":"这不是锅，是个带把手的盆！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I am concerned, User Dave. What if he speaks true?","zh":"我很担心，用户戴夫。要是他说的是真的呢？"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I'm too taco-addled to care, Penny! FORWARD!","zh":"我被玉米卷搞昏头了，顾不上这些！潘妮！前进！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"MODERN_33_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I beseech you, time-zippers, you must listen to reason!","zh":"我恳求你们，时空穿梭者们，做事有点理性判断！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Coherence crumbles! Our eras become nonsensical!","zh":"时间的连贯性正在崩塌！我们的时代正变得荒诞不经！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Stuff is all jiggy and super wacked-out, like!","zh":"现在情况完全乱套而且超离谱，真的！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"RELEASE THE SQUIRBOS!","zh":"释放松鼠！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"MODERN_33_OUTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I am telling the truth, Insane Dave Person!","zh":"我说的是大实话，疯子戴夫老兄！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"My words are utterly not an attempt to trick you!","zh":"我的话真不是想骗你的鬼话！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"You cannot re-eat a taco! It is impossible!","zh":"你不能重复吃同一个玉米卷！这是不可能的！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Imp-possible? I HATE IMPS! WITH A PASSION!","zh":"小-鬼话？我讨厌小鬼！恨之入骨！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}]},"ui":{}}
