c03b7.mp3","dino/audio/41910dda-24ac-4fa4-9003-b1215e75b714.mp3","dino/audio/23a54dde-ce59-4f7d-8c68-0d16d04bf69b.mp3","dino/audio/82fe057c-6784-4233-a792-8eccf2bd156a.mp3","dino/audio/a55b74cd-b945-4cc4-b690-6ae21c8910c8.mp3","dino/audio/3466437a-85ee-49fb-9db3-98a591426f7b.mp3","dino/audio/41551bb7-06a2-436c-b134-fc19627abc0b.mp3","dino/audio/9c29325c-704b-447c-bed3-474361fbda17.mp3","dino/audio/2e9651f9-d277-4af1-bb61-b953aca557de.mp3","dino/audio/63d3e28d-9c86-4b64-85d5-7b6b674c6719.mp3","dino/audio/fb93adb9-b248-4dd6-bcbf-32574c90090a.mp3","dino/audio/812dc1d0-91f7-4e19-a88d-1b9064258002.mp3","dino/audio/8e1d2b63-68b2-421d-ba2e-9c4f4bf1a0b0.mp3","dino/audio/3a5c2606-5516-47e7-9d5c-42ae9296591b.mp3","dino/audio/79f1afbf-b9ba-483e-a18d-1dd7a243e874.mp3"],"zombossicon/Say_Med":["dino/audio/dbc24b85-aea4-44c1-bd70-29f0e79a6cde.mp3","dino/audio/16c498f2-e40f-49ef-bffc-3f2623a0f6a8.mp3","dino/audio/6b4a7259-035b-42b9-9d89-bdab5cfbcdef.mp3","dino/audio/9fa63ae2-17bf-4aec-a693-f21946100110.mp3"]},"narratives":{"DINO_1_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Alert, User Dave. My sensors indicate we have moved 153,954,765 years into the past.","zh":"警告，用户戴夫。我的传感器显示，我们已回到了153,954,765年之前。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Yabbers! That's before I was even born!","zh":"天哪！那会儿我还没出生呢！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Correct. We seem to have landed in some form of Jurassic Marsh.","zh":"正确。看来我们掉进了某个侏罗纪沼泽之中。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I knew I smelled more oxygen!","zh":"难怪我闻到了更多氧气！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"DINO_2_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"This epoch is known for its unusual lifeforms, User Dave.","zh":"用户戴夫，这个纪元以其不寻常的生命形式而闻名。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I know! Gymnosperms, right?","zh":"我懂了！裸子植物，对不对？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I was thinking more in terms of saurians, User Dave. Dinosaurs.","zh":"用户戴夫，我更多是在指蜥形纲动物。恐龙。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"They won't attack us directly and we can't affect them.","zh":"它们不会直接攻击我们，我们也没办法干涉它们。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"However, they will definitely react to zombies. Be wary!","zh":"但是，它们肯定会对僵尸有所反应。多加小心！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"DINO_6_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I can feel the ground a-trembling, Penny! More dinos?","zh":"我感觉地面都在颤动，潘妮！更多恐龙要来了？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed, User Dave. A herd of stegosaurs approaches.","zh":"确实，用户戴夫。一群剑龙正在接近。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My sensors indicate they will snare zombies with their tail, and then flick them off.","zh":"我的传感器显示，它们将用尾部缠绕僵尸，随后将其弹射出去。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"That's what I would do!","zh":"我也会这么做！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"DINO_8_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I have analyzed a new plant, User Dave.","zh":"我已经分析了一株新植物，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Perfume-shroom charms dinosaurs and turns them against the zombies.","zh":"香水菇能魅惑恐龙，让它们调头去攻击僵尸。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Dino-sour power? On OUR side? This is taco-level great news!","zh":"恐龙之力？为我们所用？这真是个玉米卷级的好消息！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"DINO_9_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Penny! I just remembered how much I love silent letters!","zh":"潘妮！我刚刚想起来我有多喜欢单词里不发音的字母！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Coincidentally, User Dave, a flock of Pterodactyls is approaching.","zh":"说来也巧，用户戴夫，一群翼龙正在向我们接近。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Pterodactyls? That's ptotally pterrific!","zh":"翼龙？那真是龙重欢迎！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"DINO_15_OUTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Look, Penny! A fresh star-hunky!","zh":"快看，潘妮！一个新鲜的大星星！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"A meteorite. Curious. My records indicate this should be... bigger.","zh":"一颗陨石。有点意思。我的记录显示，它本应……更大一些。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":" Bigger? Like, super burrito-sized?","zh":"更大？像是超级玉米卷那么大吗？"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"More like super Seattle-sized. I hope history has not gone awry...","zh":"得有一座西雅图城那么大吧。我希望历史没有出错……"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"DINO_16_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Surrender your brains forthwith, inane time stumblers!","zh":"愚钝的时空绊倒者，速速将大脑交出来！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Else you shall share the fate of these terrible thunder lizards: EXTINCTION!","zh":"否则你们就会和这些可怕的雷龙一样：灭绝！！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"But I don't want to get extincted!","zh":"可我不想灭绝！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"DINO_17_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"...sigh...","zh":"……唉……"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"What troubles you, User Dave?","zh":"是什么在困扰你，用户戴夫？"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I just always wanted a primitive sunflower who gave big suns!","zh":"我只想要一个会生产大阳光的，原始的向日葵！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Prepare for satisfaction, User Dave.","zh":"请准备获得满足，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}],"DINO_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I see a toenail! Of unusual size!","zh":"我看到一块脚趾甲！好大！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"This raptor claw bespeaks an ancient arena of dinosaurian dimensions, User Dave!","zh":"这只巨爪诉说着远古恐龙时代的竞技场，用户戴夫！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"DINO_21_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Beware the Jurassic Bully zombies, User Dave.","zh":"小心侏罗纪野人僵尸，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"They are immune to the Primal Peashooter's knockback effect.","zh":"它们免疫原始豌豆射手的击退效果。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Zuh? But how? Even Gargantuars get knocked back!","zh":"啥？可是怎么可能？就连巨尸都会被击退！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"True, User Dave. The Bully is simply too stupid to observe typical physics.","zh":"正确，用户戴夫。野人的智力水平不足以支撑其遵循经典物理学原理。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"DINO_23_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I detect Primal Potato Mines nearby, User Dave.","zh":"我侦测到原始土豆地雷就在附近，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Their prepaleolithic potency will far exceed our more refined modern versions.","zh":"他们旧石器时代前的威力将远超我们更为精致的现代版本。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"BASHED potatoes? I love them already!","zh":"暴揍土豆？光听名字我就爱上了！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"DINO_INTRO_ZOMBOSS":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"My infuriation is epochal! ","zh":"我的怒火已经超越次元了！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Is there nowhen I may go to avoid your imbecilic interference?","zh":"难道就没有一个时间段是我能躲开你们愚蠢的干涉的吗？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Stay right where you are. I have an enormous rock scheduled to make your acquaintance.","zh":"站在那里别动。我已经为你们预定好了与一块巨石的会面！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I just hate a ticking rock!","zh":"我就是讨厌那种会滴答响的石头！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"DINO_OUTRO_ZOMBOSS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I detect an incoming meteor, User Dave","zh":"我侦测到一颗袭来的流星，用户戴夫！"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I advise immediate egress from this timezone.","zh":"我建议立刻撤离这个时间段。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Bye-bye, dinos! You'll be birdies in no time!","zh":"再见啦，小恐龙们！你们马上就会变成小鸟啦！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Haha! My trip here was never about taking you down!","zh":"哈哈！来这里一趟根本不是为了打倒你们！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"...Though it would be way too easy to make that come true!","zh":"……尽管打倒你们再轻松不过了！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I've acquired an endless supply of oil resources!","zh":"我已经获得了无穷无尽的石油资源！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Soon we'll fill the entire sky with gunpowder smoke!","zh":"我们很快就能用硝烟填满整个天空！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"}],"DINO_33_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Hey! The past is still just when we left it!","zh":"嘿！过去的一切都原封未动呢！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"True, with differences. More Jurassic zombies have appeared, with amplified abilities.","zh":"确实如此，但仍存在差异。更多具有强化能力的侏罗纪僵尸出现了。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Our plants may need to practiseing to provide sufficient protection.","zh":"我们的植物可能需要锻炼来提供足够的保护。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"DINO_34_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Ow-yowsers! Our lawnmowers have gone extinct!","zh":"哎呀糟糕！我们的小推车都灭绝了！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Time fluxes interfere with mowing technology, User Dave.","zh":"时间流干扰了割草技术，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We must plant with additional care lest we be overrun.","zh":"我们必须更加小心地种植植物，否则我们将被彻底淹没。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}]},"ui":{}}
