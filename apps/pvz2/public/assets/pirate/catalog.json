ction":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Finally, one of these pirates dropped some booty!","zh":"终于有带着金银财宝的水手被我们收拾了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"I'm detecting something more challenging than treasure inside.","zh":"我检测到这堆财宝中有更危险的东西要来。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"PIRATE_CHALLENGE_PRESET_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Butter and spikes and everything nice.","zh":"黄油、地刺和各种好东西。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"That's what butter and spikes are made of.","zh":"这就是黄油和地刺诞生的意义。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"That's hard to argue or agree with.","zh":"这真让人难以反驳，也难以赞同。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}],"PIRATE_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Hail fellow Captain,","zh":"向您敬礼，船长，"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Be advised that your sailing vessel is of insufficient size.","zh":"在此提醒您，您的船帆尺寸不匹配。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Sincerely, Dr. Edgar Zomboss.","zh":"此致，埃德加·僵尸博士。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Huh? What's that now?","zh":"呃，这次又是什么情况？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"We're gonna need a bigger boat.","zh":"我们可能需要一条更大的船了。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"PIRATE_CHALLENGE_MINIGAME_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Target score activated. Let's see if you can beat my high score.","zh":"检测到需要达到目标分数，看看你能不能破我的纪录。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"And put in KRZYDV as your initials.","zh":"而且得输入 KRZYDV 作为你的姓名首字母缩写。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_CHALLENGE_LASTSTAND_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It's low tide and the waves are coming in.","zh":"现在处于低潮时段，而且马上潮水就要汹涌而来。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Grab your water wings! We're going to get wet.","zh":"戴好水翼！我们要被淹没了。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}]},"ui":{"note-pirate":{"image":"pirate/ui/1c3d69c2-94b4-4ff1-bc81-8e9e8a71f6b2_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"pirate"}}}
