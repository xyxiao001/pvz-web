y_Long"}],"PIRATE_35_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"The timbers be shivered! The seas are ablaze!","zh":"桅杆将要撕裂！海面将会燃烧！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Your doom is assured! Your mind is a haze!","zh":"你必死无疑！你的颅内将只剩混沌！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"The Zombot Plank Walker 2.0 shall soon rule the waves!","zh":"我的甲板漫步者 2.0 即将统治浪潮！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}],"PIRATE_35_OUTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"We lived! Take that, planks and zombies and seaweed!","zh":"我们活下来了！接招吧，甲板，僵尸和海藻！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed, User Dave, piracy is not a victimless crime.","zh":"确实如此，用户戴夫，海盗行为的受害者非常多。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"PIRATE_26_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I see more seas! Arrrr there more zombies?","zh":"我看到了更远的海平面！额惹惹惹，还有更多僵尸？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"More pirate zombies have appeared, and with greater strength.","zh":"更多的海盗僵尸出现了，他们更加精壮。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We may need to retreat to another timeline and return when our plants are stronger.","zh":"或许我们该暂时撤退到其他时间线，带着更强大的植物回来应战。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"PIRATE_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"I thought we were trying to get back home and get your taco.","zh":"我已经尽力想办法回到旧家然后再找玉米卷了。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SHOUT","Lines":{"en":"But Pirates! Hang on to your parrots and peg legs!","zh":"但是这里全是海盗！赶紧准备好你的鹦鹉和假腿！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Finally, one of these pirates dropped some booty!","zh":"终于有带着金银财宝的水手被我们收拾了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"I'm detecting something more challenging than treasure inside.","zh":"我检测到这堆财宝中有更危险的东西要来。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"PIRATE_CHALLENGE_PRESET_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Butter and spikes and everything nice.","zh":"黄油、地刺和各种好东西。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"That's what butter and spikes are made of.","zh":"这就是黄油和地刺诞生的意义。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"That's hard to argue or agree with.","zh":"这真让人难以反驳，也难以赞同。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}],"PIRATE_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Hail fellow Captain,","zh":"向您敬礼，船长，"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Be advised that your sailing vessel is of insufficient size.","zh":"在此提醒您，您的船帆尺寸不匹配。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Sincerely, Dr. Edgar Zomboss.","zh":"此致，埃德加·僵尸博士。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Huh? What's that now?","zh":"呃，这次又是什么情况？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"We're gonna need a bigger boat.","zh":"我们可能需要一条更大的船了。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"PIRATE_CHALLENGE_MINIGAME_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Target score activated. Let's see if you can beat my high score.","zh":"检测到需要达到目标分数，看看你能不能破我的纪录。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"And put in KRZYDV as your initials.","zh":"而且得输入 KRZYDV 作为你的姓名首字母缩写。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_CHALLENGE_LASTSTAND_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It's low tide and the waves are coming in.","zh":"现在处于低潮时段，而且马上潮水就要汹涌而来。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Grab your water wings! We're going to get wet.","zh":"戴好水翼！我们要被淹没了。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"PIRATE_CHALLENGE_PROTECTPLANTS_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Remember, protect those plants.","zh":"记住，要保护好那些植物。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"And don't let those beans walk the plank.","zh":"而且别让那些豆子被抓去走甲板。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"PIRATE_INTRO_ZOMBOSS":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I've discovered a mysterious trait in your rattletrap time machine.","zh":"我在你的那嘎吱响的时光机里发现了一个秘密。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Its temporal signature is nearly identical to my own creations.","zh":"它的时间相性与我自己的创作几乎完全相同。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Explain to me, how was this \"Penny\" created in the first place?","zh":"请向我解释一下，这个“潘妮”是从哪里来的？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Could I really be some form of Zombot?","zh":"难不成我是博士机甲的另一种变体？"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"User Dave, am I the daughter of Dr. Zomboss?","zh":"用户戴夫，我是僵尸博士的发明之一吗？"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"That was one fine sandwich! So, what did I miss?","zh":"我刚吃了一份美味的三明治！额，你们刚刚在聊啥呢？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_OUTRO_ZOMBOSS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Please, tell me about your creation process.","zh":"请告诉我您当初的创造流程。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"It was pretty easy! I found some timey wabby wabbo stuff.","zh":"很简单的！我当时找到了一堆哇啦哇啦的时空玩意。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Then I put it between two slices of bread...","zh":"然后把它们夹在两片面包中间……"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"BOOM! Awesome sandwich!","zh":"轰！超级美味的三明治！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Such proliferous bunk. I should have expected as much.","zh":"只是问出来一堆废话，我早该料到的。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I'll have the answers someday, when David's brains are on my plate.","zh":"等我夺到了戴夫的脑子，我会得到答案的。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}]},"rewards":{"dangerroom_pirate2":{"OBTAINWORLD":"pirate","CODENAME":"dangerroom_pirate2","SPRITENAME":"dangerroom_pirate","TROPHYTYPE":"dangerroom","NAME":{"en":"Access to Dead Man's Booty!","zh":"通往死人的遗产！"},"DESCRIPTION":{"en":"Survive level after level of escalating zombie attacks. Test your skills in this Endless Zone.","zh":"在一波又一波愈演愈烈的僵尸攻势中生存下来，在此无尽空间中挑战你的极限。"},"objdata":{"UnlockLevel":["pirate_dangerroom2"]}}},"ui":{"note-pirate":{"image":"pirate/ui/1c3d69c2-94b4-4ff1-bc81-8e9e8a71f6b2_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"pirate"}}}
