ave","Action":"SHOUT","Lines":{"en":"But Pirates! Hang on to your parrots and peg legs!","zh":"但是这里全是海盗！赶紧准备好你的鹦鹉和假腿！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Finally, one of these pirates dropped some booty!","zh":"终于有带着金银财宝的水手被我们收拾了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"I'm detecting something more challenging than treasure inside.","zh":"我检测到这堆财宝中有更危险的东西要来。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"PIRATE_CHALLENGE_PRESET_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Butter and spikes and everything nice.","zh":"黄油、地刺和各种好东西。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"That's what butter and spikes are made of.","zh":"这就是黄油和地刺诞生的意义。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"That's hard to argue or agree with.","zh":"这真让人难以反驳，也难以赞同。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}]},"ui":{}}
