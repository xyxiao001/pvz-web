f9a.mp3","pirate/audio/25847bb2-c7b5-4f60-bfec-4fd15c91a806.mp3","pirate/audio/3dd296af-c586-4c4d-b82d-1a1b66c25c12.mp3","pirate/audio/7f91950e-0c4d-4525-a0d6-2962cdd95869.mp3","pirate/audio/2ccad67c-4b9b-449d-bcdf-d541d9fc5843.mp3","pirate/audio/05bf51c5-dc71-4d2b-82e4-f0350e4c3407.mp3"],"zombossicon/Say_Long":["pirate/audio/519753c6-6d42-41cf-acdf-9df6e8c15d01.mp3","pirate/audio/e3aa0ce3-4771-464a-8e95-dc89529aa792.mp3","pirate/audio/aaef7c4b-1d6b-4ae5-ba93-795a06b5e1cf.mp3","pirate/audio/757f97cc-05cc-4d82-9775-a62892ebe0af.mp3"]},"narratives":{"PIRATE_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"I thought we were trying to get back home and get your taco.","zh":"我已经尽力想办法回到旧家然后再找玉米卷了。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SHOUT","Lines":{"en":"But Pirates! Hang on to your parrots and peg legs!","zh":"但是这里全是海盗！赶紧准备好你的鹦鹉和假腿！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Finally, one of these pirates dropped some booty!","zh":"终于有带着金银财宝的水手被我们收拾了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"I'm detecting something more challenging than treasure inside.","zh":"我检测到这堆财宝中有更危险的东西要来。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"PIRATE_CHALLENGE_PRESET_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Butter and spikes and everything nice.","zh":"黄油、地刺和各种好东西。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"That's what butter and spikes are made of.","zh":"这就是黄油和地刺诞生的意义。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"That's hard to argue or agree with.","zh":"这真让人难以反驳，也难以赞同。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}],"PIRATE_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Hail fellow Captain,","zh":"向您敬礼，船长，"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Be advised that your sailing vessel is of insufficient size.","zh":"在此提醒您，您的船帆尺寸不匹配。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Sincerely, Dr. Edgar Zomboss.","zh":"此致，埃德加·僵尸博士。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Huh? What's that now?","zh":"呃，这次又是什么情况？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"We're gonna need a bigger boat.","zh":"我们可能需要一条更大的船了。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"PIRATE_CHALLENGE_MINIGAME_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Target score activated. Let's see if you can beat my high score.","zh":"检测到需要达到目标分数，看看你能不能破我的纪录。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"And put in KRZYDV as your initials.","zh":"而且得输入 KRZYDV 作为你的姓名首字母缩写。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_CHALLENGE_LASTSTAND_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It's low tide and the waves are coming in.","zh":"现在处于低潮时段，而且马上潮水就要汹涌而来。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Grab your water wings! We're going to get wet.","zh":"戴好水翼！我们要被淹没了。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"PIRATE_CHALLENGE_PROTECTPLANTS_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Remember, protect those plants.","zh":"记住，要保护好那些植物。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"And don't let those beans walk the plank.","zh":"而且别让那些豆子被抓去走甲板。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"PIRATE_INTRO_ZOMBOSS":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I've discovered a mysterious trait in your rattletrap time machine.","zh":"我在你的那嘎吱响的时光机里发现了一个秘密。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Its temporal signature is nearly identical to my own creations.","zh":"它的时间相性与我自己的创作几乎完全相同。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Explain to me, how was this \"Penny\" created in the first place?","zh":"请向我解释一下，这个“潘妮”是从哪里来的？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Could I really be some form of Zombot?","zh":"难不成我是博士机甲的另一种变体？"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"User Dave, am I the daughter of Dr. Zomboss?","zh":"用户戴夫，我是僵尸博士的发明之一吗？"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"That was one fine sandwich! So, what did I miss?","zh":"我刚吃了一份美味的三明治！额，你们刚刚在聊啥呢？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"PIRATE_OUTRO_ZOMBOSS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Please, tell me about your creation process.","zh":"请告诉我您当初的创造流程。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"It was pretty easy! I found some timey wabby wabbo stuff.","zh":"很简单的！我当时找到了一堆哇啦哇啦的时空玩意。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Then I put it between two slices of bread...","zh":"然后把它们夹在两片面包中间……"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"BOOM! Awesome sandwich!","zh":"轰！超级美味的三明治！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Such proliferous bunk. I should have expected as much.","zh":"只是问出来一堆废话，我早该料到的。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I'll have the answers someday, when David's brains are on my plate.","zh":"等我夺到了戴夫的脑子，我会得到答案的。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}]},"ui":{"note-pirate":{"image":"pirate/ui/1c3d69c2-94b4-4ff1-bc81-8e9e8a71f6b2_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"pirate"}}}
