s":{"ICEAGE_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Brrrrr. It's colder than a polar bear eating an ice pop!","zh":"嘶——这比吃着冰棒的北极熊还冷！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed. It appears we have arrived in the Frostbite Caves.","zh":"确实。看来我们已抵达极寒冰窟。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"We've traveled so far back in history ... we've arrived in PREhistory!","zh":"我们穿越历史如此之久……竟来到了史前时代！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"A historic moment indeed, User Dave. But more importantly...","zh":"这确实是历史性时刻，用户戴夫。但更重要的是……"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"My sensors indicate there is an ice floe on the lawn.","zh":"我的传感器检测到草坪上出现了浮冰。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Data suggests it will block both plants and zombies.","zh":"数据表明它将同时阻挡植物和僵尸。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Though I predict hungry zombies will find a way around it.","zh":"但我预测饥饿的僵尸会找到方法绕过它。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Don't worry. We'll plant wisely and stop those zombies COLD!","zh":"别担心。我们会巧妙种植，让那些僵尸彻底冻僵！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"}],"ICEAGE_INTRO_ICEBLOCKS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Don't look now, Penny, but those plants have a bad case of freezer burn!","zh":"别看现在，潘妮，那些植物可是严重冻伤了！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"It's the freezing winds from this time period. They've immobilized the plants.","zh":"是这个时代的寒风所致。它们让植物无法行动了。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"I suggest we call on Hot Potato. She can melt those ice blocks.","zh":"我建议召唤烤马铃薯。她能融化那些冰块。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I'm warming up to the idea already!","zh":"听了这个主意我就暖和起来了！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"ICEAGE_INTRO_HURRIKALE":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My data suggests Hurrikale would be of great use here.","zh":"我的数据表明飓风甘蓝在此地会非常有用。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"A blast of air from him, and the zombies will chill out and slow down!","zh":"他释放的寒风能让僵尸冷静下来并减速！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"The guy's a real blow hard. And I mean that in the nicest way possible.","zh":"这家伙可是个真正的吹风高手——我用最友善的意思说这话。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}]},"ui":{}}
