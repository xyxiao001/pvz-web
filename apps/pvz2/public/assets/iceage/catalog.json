,"iceage/audio/6c77972b-7609-4993-aadc-97af959f20ed.mp3","iceage/audio/4cd64531-927e-4b11-bd4e-d19ff836f61d.mp3","iceage/audio/f887cc61-9b50-4195-b55e-92b95b0d8db3.mp3","iceage/audio/32f3dc3b-cf74-49b9-8320-18ab2db55c62.mp3","iceage/audio/9691871c-b47c-40ee-9c48-1f31bdb77854.mp3","iceage/audio/f167c30b-b841-434d-8899-578bb3ef6b94.mp3","iceage/audio/7e860eea-9c4d-4e1d-afec-b1b79a96c5f4.mp3","iceage/audio/583003e1-7b06-47b1-b57d-75915d57c742.mp3","iceage/audio/a6007fe6-73ea-47f6-8013-f7343f1d3574.mp3","iceage/audio/b12da939-dedb-4c40-984c-40cca6f3d0c8.mp3","iceage/audio/c740295d-1e04-4219-aba2-fc9769e39b3c.mp3","iceage/audio/57f2a981-c3c4-4680-be6b-98063876f0cb.mp3","iceage/audio/80b98244-e39a-420e-bf27-2c4c8b547e3f.mp3","iceage/audio/65b024a9-23ee-4691-8c76-063cedbfcf88.mp3","iceage/audio/5c559a5a-fdfd-4a38-91fd-2eb1311d86d6.mp3","iceage/audio/16be66ad-bc61-4b18-acfc-f5e79bd3ea6e.mp3","iceage/audio/0b9b0617-6056-424d-bf7c-72ae803cf50c.mp3","iceage/audio/216b7246-ad46-4eab-948a-0207d11fced2.mp3","iceage/audio/7f6a3d77-284e-4741-b1bd-8dc9239bff74.mp3","iceage/audio/4be09f32-ef6b-4be5-b132-335d1c72c4c9.mp3","iceage/audio/e87b43dd-3fae-44d9-b9ba-1f8eff03ed23.mp3","iceage/audio/54afe536-9002-435a-b633-f31e583206c3.mp3","iceage/audio/2f63afcc-42ee-4c36-8ac5-817ce26db34b.mp3","iceage/audio/134ca1b8-ae87-4343-a5a5-748b757a50be.mp3","iceage/audio/059f10bb-9721-4912-9326-bc350c4d4122.mp3","iceage/audio/6dd11699-f1c1-42a2-9c9f-05801a763323.mp3","iceage/audio/49a97d41-9a33-446c-b097-3a011286d006.mp3","iceage/audio/78495e3a-412d-4394-b768-d547bae1ed53.mp3","iceage/audio/6ea0f851-abae-4f59-aeea-0b52a961ba12.mp3"],"crazydave/Playful_Short":["iceage/audio/782351fd-4ea7-4356-b6e9-50187b92c14f.mp3","iceage/audio/4ee34818-438f-46b8-9d4b-11d6ee31c124.mp3","iceage/audio/c1c00325-7e0a-4c3a-9636-f12c3bce03e7.mp3"]},"narratives":{"ICEAGE_INTRO_ZOMBOSS":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Gurrreetings! Dr. Zomboss have prehistoric question for pitiful plant friends.","zh":"咕呜呜问候！僵尸博士有个史前问题要问可怜的植物朋友们。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Why you hunt for taco? Is taco all it cracked up to be?","zh":"你们为何追寻塔可？塔可真有传说中那么完美吗？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Could it be ... trap? Could it be ... trick?","zh":"会不会是个……陷阱？会不会是个……诡计？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Chew on that! Mwwwahahaha unga unga!","zh":"好好琢磨吧！呜哇哈哈哈嗯嘎嗯嘎！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Penny ... my taco!?!","zh":"潘妮……我的玉米卷！？！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"User Dave, ignore the taco. Ignore the taunts.","zh":"用户戴夫，忽略玉米卷。忽略嘲讽。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"It's time to FIGHT DR. ZOMBOSS!","zh":"是时候对战僵尸博士了！"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"ICEAGE_OUTRO_ZOMBOSS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Well done. We have defeated Dr. Zomboss.","zh":"干得漂亮。我们已击败僵尸博士。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"And his attempt to make me question my taco!","zh":"还有他试图让我怀疑玉米卷的阴谋！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"User Dave, our journey through time ...","zh":"用户戴夫，我们的时空之旅……"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"You know that it is about more than just a taco.","zh":"你明白这不仅仅关乎一个塔可。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"I suppose you're right, Penny. It's also about-","zh":"我想你是对的，潘妮。这还关乎——"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Ha! Dr. Zomboss not defeated!","zh":"哈！僵尸博士还没被击败！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Dr. Zomboss crawl back from brink of destruction!","zh":"僵尸博士从毁灭边缘爬回来了！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Dr. Zomboss return when you no expect him. Bring BIG SURPRISE!","zh":"僵尸博士在你们意想不到时归来。带来超大惊喜！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Dr. Zomboss stop speaking about self in third-person now! Guuudbye!","zh":"僵尸博士现在停止用第三人称来称呼自己了！古德拜！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}],"ICEAGE_INTRO_XSHOT":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Penny, what we need right now is a nice hot cup o' cocoa!","zh":"潘妮，我们现在需要的是一杯热可可！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"User Dave, that is an unproven zombie-fighting weapon.","zh":"用户戴夫，这可是未经证实的打僵尸武器。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I recommend we call on Rotobaga instead.","zh":"我建议改为召唤旋转芜菁。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"She can hover above ground AND shoot at zombies in four directions!","zh":"她能悬停在地面之上，还能向四个方向射击僵尸！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Kid's got talent! Maybe she knows how to make hot cocoa too?","zh":"这孩子真有天赋！说不定她还会泡热可可呢？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"ICEAGE_INTRO_FIREPEASHOOTER":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"W-w-warning, User Dave! I am r-r-running l-l-low on antifreeze!","zh":"警-警告，用户戴夫！防-防冻液即-即将耗尽！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"If my systems f-f-f-freeeze up, we could be stuck here forever!","zh":"如-如果我的系统冻-冻结，我们可-可能会永远困在这里！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"It'll be a cold day in heck before I let that happen, Penny!","zh":"我绝不会让这种事发生的，潘妮！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Time to unleash Fire Peashooter!","zh":"是时候释放火焰豌豆了！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"She can apply heat to those zombies, and warm up nearby pals too!","zh":"她能对僵尸施加灼热攻击，同时为附近队友提供温暖！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"ICEAGE_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"User Dave, I've detected an incoming ice cube.","zh":"用户戴夫，检测到巨型冰块正在接近。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Looks like a zombie-sicle to me.","zh":"我看这像根僵尸冰棒。"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Analysis suggests this creepy cube unlocks a chilly challenge.","zh":"分析表明这个诡异的冰块将开启一场寒冷的挑战。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"You know what I say? Brrrrr-ing it on!","zh":"知道我的态度吗？放—马—过—来—吧！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"ICEAGE_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Brrrrr. It's colder than a polar bear eating an ice pop!","zh":"嘶——这比吃着冰棒的北极熊还冷！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed. It appears we have arrived in the Frostbite Caves.","zh":"确实。看来我们已抵达极寒冰窟。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"We've traveled so far back in history ... we've arrived in PREhistory!","zh":"我们穿越历史如此之久……竟来到了史前时代！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"A historic moment indeed, User Dave. But more importantly...","zh":"这确实是历史性时刻，用户戴夫。但更重要的是……"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"My sensors indicate there is an ice floe on the lawn.","zh":"我的传感器检测到草坪上出现了浮冰。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Data suggests it will block both plants and zombies.","zh":"数据表明它将同时阻挡植物和僵尸。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Though I predict hungry zombies will find a way around it.","zh":"但我预测饥饿的僵尸会找到方法绕过它。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Don't worry. We'll plant wisely and stop those zombies COLD!","zh":"别担心。我们会巧妙种植，让那些僵尸彻底冻僵！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"}],"ICEAGE_INTRO_ICEBLOCKS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Don't look now, Penny, but those plants have a bad case of freezer burn!","zh":"别看现在，潘妮，那些植物可是严重冻伤了！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"It's the freezing winds from this time period. They've immobilized the plants.","zh":"是这个时代的寒风所致。它们让植物无法行动了。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"I suggest we call on Hot Potato. She can melt those ice blocks.","zh":"我建议召唤烤马铃薯。她能融化那些冰块。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I'm warming up to the idea already!","zh":"听了这个主意我就暖和起来了！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"ICEAGE_INTRO_HURRIKALE":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My data suggests Hurrikale would be of great use here.","zh":"我的数据表明飓风甘蓝在此地会非常有用。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"A blast of air from him, and the zombies will chill out and slow down!","zh":"他释放的寒风能让僵尸冷静下来并减速！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"The guy's a real blow hard. And I mean that in the nicest way possible.","zh":"这家伙可是个真正的吹风高手——我用最友善的意思说这话。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"ICEAGE_INTRO_PEPPERPULT":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"I'm starting to get cold feet about this place.","zh":"我开始对这地方感到心里发寒了。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Also, my feet are getting really cold.","zh":"另外，我的脚确实越来越冷了。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Time to turn up the heat. I recommend Pepper-pult for the job.","zh":"是时候升温了。我推荐甜椒投手来执行任务。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"He lobs hot peppers at zombies and also keeps nearby plants warm.","zh":"他向僵尸投掷辣椒，同时为附近植物提供温暖。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Let's pick a peck of Pepper-pults! It's the perfect plant for our predicament!","zh":"让我们选一组甜椒投手！这真是我们在困境中的完美帮手！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Must you rhyme, User Dave? Must you?","zh":"非得押韵吗，用户戴夫？非这样不可吗？"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"ICEAGE_INTRO_FLAMETHROWER":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"Global cooling is the pits. What we need is a heat wave!","zh":"全球变冷真糟糕。我们现在需要的是热浪！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Agreed. Please note, I have now replaced the snowballs with fireballs.","zh":"同意。请注意，我已将雪球替换为火球。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The Flamethrower power-up melts frost and damages zombies too.","zh":"火焰指既能融化冰霜又能伤害僵尸。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Neat-o! You know, they say revenge is a dish best served cold.","zh":"妙极了！要知道，人们都说，复仇是道凉菜更好吃。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"But I say it's best served hot. Fiery hot! With extra hot sauce.","zh":"但我觉得最好热辣享用。烈火烹油般的热辣！还要加额外辣酱。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"And a side of tacos!","zh":"再加一份玉米卷！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"ICEAGE_INTRO_CHARDGUARD":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"These Cave Zombies sure are hard headed.","zh":"这些洞穴僵尸真是顽固至极。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"They just won't take \"no brains\" for an answer.","zh":"它们根本不接受“不吃脑子”的拒绝。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"According to my data, Neanderthal zombie skulls are 33.2 percent harder than other zombie skulls.","zh":"根据我的数据，尼安德特僵尸的头骨硬度比其他僵尸高出33.2%。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I propose we deploy Chard Guard. He has a secret up his leaves.","zh":"我建议部署甜菜护卫。他的叶片下藏着秘密武器。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"You mean his ol' Knock 'Em Dead maneuver?","zh":"你是指他那招致命击退的老把戏？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"It'll knock those zombies back where they came from!","zh":"这招能把那些僵尸全轰回老巢！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"I guess it's not a secret any more, now is it User Dave?","zh":"看来这已经不是秘密了，对吧用户戴夫？"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"ICEAGE_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Me Zomboss. Me write you another threatening note.","zh":"我，僵尸博士。我，给你写张新的威胁纸条。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"You in trouble. Biiiiig trouble. Gargantuan trouble, in fact!","zh":"你摊上事了。摊上大——大事了。其实是巨人般的大事！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Sloth Gargantuar smash! Smash your tiny, shivering plants!","zh":"懒散巨尸要砸扁！砸扁你那些瑟瑟发抖的小植物！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Sloth Gargantuar deliver prehistoric plague of Imps!","zh":"懒散巨尸正在投放史前小鬼瘟疫！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Have bad day. Sincerely, Dr. Zomboss","zh":"祝你有糟糕的一天。诚挚的，僵尸博士"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I postulate evolution will never come to that zombie.","zh":"我断定那个僵尸永远不会进化了。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Not in a million, billion, gazillion years.","zh":"就算过一百万年、十亿年、兆年也不可能。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"}],"ICEAGE_INTRO_STUNION":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"I wish these prehistoric zombies would just go back to their caves.","zh":"但愿这些史前僵尸能安分地回到他们的洞穴"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"User Dave, perhaps it's time to try a new tactic.","zh":"用户戴夫，或许是时候尝试新战术了。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Data suggests Stunion would make for a ... potent ... ally here.","zh":"数据表明眩晕洋葱在此地会成为……强效……盟友。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Great idea, Penny! That guy's breath is stunning!","zh":"好主意，潘妮！那家伙的口气简直令人震撼！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Not even exaggerating. He stuns zombies ... with his bad breath.","zh":"毫不夸张。他能用口臭……震慑僵尸。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Gross. But also, pretty nifty!","zh":"恶心……不过也挺厉害！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}]},"ui":{"note-iceage":{"image":"iceage/ui/0387e9d2-73e6-43db-b0ce-e2a0c05bd524_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"iceage"}}}
