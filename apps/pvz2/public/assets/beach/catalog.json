10805acc03b7.mp3","beach/audio/41910dda-24ac-4fa4-9003-b1215e75b714.mp3","beach/audio/23a54dde-ce59-4f7d-8c68-0d16d04bf69b.mp3","beach/audio/82fe057c-6784-4233-a792-8eccf2bd156a.mp3","beach/audio/a55b74cd-b945-4cc4-b690-6ae21c8910c8.mp3","beach/audio/3466437a-85ee-49fb-9db3-98a591426f7b.mp3","beach/audio/41551bb7-06a2-436c-b134-fc19627abc0b.mp3","beach/audio/9c29325c-704b-447c-bed3-474361fbda17.mp3","beach/audio/2e9651f9-d277-4af1-bb61-b953aca557de.mp3","beach/audio/63d3e28d-9c86-4b64-85d5-7b6b674c6719.mp3","beach/audio/fb93adb9-b248-4dd6-bcbf-32574c90090a.mp3","beach/audio/812dc1d0-91f7-4e19-a88d-1b9064258002.mp3","beach/audio/8e1d2b63-68b2-421d-ba2e-9c4f4bf1a0b0.mp3","beach/audio/3a5c2606-5516-47e7-9d5c-42ae9296591b.mp3","beach/audio/79f1afbf-b9ba-483e-a18d-1dd7a243e874.mp3"]},"narratives":{"BEACH_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Look at this beeeeautiful beach!","zh":"看看这美丽的沙滩！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"It's got everything a growing plant needs!","zh":"这里有我们正在长身体的植物们需要的一切！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Sun, sand and lots o' water!","zh":"阳光，沙子，还有用不完的水！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Caution, User Dave. My sensors indicate there are zombies on your beach...","zh":"注意，用户戴夫。我的传感器检测到沙滩上有僵尸……"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"... and far too much water. It will overwhelm the plants.","zh":"……还有太多的水。这会把植物淹坏的。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"No problem-o! We'll just lay down some Lily Pads.","zh":"没啥大碍！我们只需要种下一些莲叶。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Then the other plants can ride the waves!","zh":"其他的植物就能玩冲浪了！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Or as the vernacular of this era goes: They can \"hang ten\".","zh":"或者用这个时代的俗语来说：他们可以“挂十”。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Right on, Penny. Right on!","zh":"说得对，潘妮！完全正确！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"BEACH_INTRO_TIDES":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"User Dave, data suggests that we should beware the tides.","zh":"用户戴夫，数据显示我们需要注意沙滩上的海水。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"When the tide comes in, it'll be a WIPE OUT for our plant friends?","zh":"你是指当海浪涨起的时候，我们的植物会被淹死吗？"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed. But the tide line indicates how high the water will rise. Plan accordingly.","zh":"正确的。但是海岸线会告诉我们海浪最多能涨到哪里。你可以依此做好计划。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"The tide comes in, the tide goes out. Who can explain it?","zh":"海水又能前进又能后退，这怎么解释得通？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"That would be science, User Dave.","zh":"交给科学吧，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"BEACH_INTRO_CHOMPER":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"When fighting zombies from the deep...","zh":"当我们对抗僵尸时，尤其是那些来自深……"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"...we need a plant with the appetite of a shark.","zh":"……我们会需要一个胃口和鲨鱼一样好的植物。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"I catch your drift, Penny. You're talking about Chomper!","zh":"我懂你意思，潘妮。你指的是大嘴花吧！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed. His sharp teeth could turn the tide of battle.","zh":"正确。他锋利的牙齿能扭转战局。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Hey, I have an idea too! We could call this Chomper Week!","zh":"嘿，我也有个好主意！我们可以把这周称为大嘴周！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"If we must, User Dave. If we must.","zh":"如果有必要的话，用户戴夫。有必要的话。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"BEACH_INTRO_BOWLING":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My research indicates that the sport of bowling experienced a heyday during this era.","zh":"根据我的调查，保龄球运动在现在是火热的运动。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Are you thinking what I'm thinking, Penny?","zh":"你和我想得一样吗，潘妮？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"I find your thought process indecipherable, User Dave.","zh":"用户戴夫，我发现你的思维过程令人难以解读。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I was thinking that Bowling Bulbs would make excellent allies here.","zh":"我在想，保龄泡泡会成为我们绝佳的帮手。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Huh. I was thinking how much I love wearing bowling shoes.","zh":"喝，我想的是我终于能穿上保龄球鞋了。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"So many colors ... right there on my feet!","zh":"五彩斑斓……印在我的脚上！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}]},"ui":{"note_beach":{"image":"beach/ui/5d199d7c-6617-4df0-9df6-985b739a059f_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"beach"}}}
