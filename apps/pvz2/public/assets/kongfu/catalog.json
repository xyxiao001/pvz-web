/audio/1fc69030-68da-44bd-9068-d48e668646d3.mp3","kongfu/audio/0968a7d5-a11e-46aa-ad42-cea3feaee869.mp3","kongfu/audio/443f622c-a2ab-4a76-85c4-edfe48bc6da1.mp3","kongfu/audio/1c717311-b84b-4405-b818-d12dd679c8b1.mp3","kongfu/audio/e2651a8d-fa65-499b-9211-56d7c4b1dde7.mp3","kongfu/audio/13150ea5-c742-47d9-a6c9-c38b1d532aa3.mp3","kongfu/audio/f0b8c475-13fc-4c2c-b11c-faa9523ab7b6.mp3","kongfu/audio/9f062aec-8464-4b73-bdc2-696c48d54b79.mp3","kongfu/audio/d3064974-a87d-419b-9267-fc1a3d5634e9.mp3","kongfu/audio/578313b7-da5c-448d-8d3d-e3b7a7c0e3c0.mp3","kongfu/audio/142c8a07-8677-41fa-ab72-3cf19ef7b4ae.mp3","kongfu/audio/48d3b1c4-1bae-4bbf-92be-a5186f434b15.mp3"]},"narratives":{"KONGFU_17_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We have attracted the attention of Monk zombies in Kongfu Temple.","zh":"我们已经引来了武林寺庙的武僧僵尸。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Compared to the Kongfu Zombies, they possess superior physical prowess and more refined combat skills.","zh":"他们相比于武斗僵尸有更强大的体魄，以及更为精湛的武艺。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I can't wait until witnessing a true Kungfu contest!","zh":"我已经等不及要来一场真正的功夫对决了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"KONGFU_19_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Heavenly Peaches heal injured plants. They emit spiritual energy and create protective shields.","zh":"仙桃会治愈受伤的植物，同时会散发出一些灵气。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Which can make plants temporarily invincible.","zh":"这可以让处在其中的植物在一段时间内免于受到来自僵尸的伤害。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"KONGFU_1_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We have arrived in 17th-century of China. All the zombies here are equipped with unique skills.","zh":"我们来到了 17 世纪的中原，这里的僵尸个个都身怀绝技。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Can we find out the secrets of Fortune Cookies here?","zh":"我们能在这找到幸运饼干的秘密吗？"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Fortune Cookies are not from China, User Dave...","zh":"中国并没有幸运饼干，用户戴夫……"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Whoa! There's a weird pattern on the lawn!","zh":"看，地上有个奇怪的图案。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The data indicates that the Tai-Chi tile contains quantities of energy.","zh":"数据显示太极地砖内蕴藏着大量的能量。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Maybe our plants could bring that energy out with there roots!","zh":"或许我们的植物可以用他们的根将这些能量提取出来！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"KONGFU_2_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"There are heat and fire entrenched in Fire Gourds' stomachs.","zh":"火葫芦的腹腔内积蓄着一团火焰。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Seems that they're in high spirits right now!","zh":"这让他看起来情绪高涨。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Tap on Fire Gourds so that they will breathe out the fire.","zh":"点击火葫芦可以让他把这团火焰喷出来，"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The further they charge, the farther they breathe.","zh":"积攒的时间越长，喷得越远。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Let's burn the zombies and all those wooden racks on the lawn down!","zh":"把僵尸和这些堆在草坪上的木架子一并烧成灰吧。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"KONGFU_4_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I just saw A zombie flew-by, somehow...","zh":"我看见有个僵尸从眼前飞了过去，不知怎么地……"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The rockets on Rocket Imps's back push them towards our defenses rapidly.","zh":"火箭小鬼背上的火箭赋予了他们快速冲向我们防线的能力。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"These annoying Imps won't stop until they collide into something.","zh":"不撞到些什么这群烦人的家伙是不会停下来的。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"They're going one way, like a taco to my belly!","zh":"看来他们并没有回头的打算。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"KONGFU_6_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I could smell dynamite.","zh":"空气中弥漫着火药味。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Don't let the zombies trigger the barrels of dynamite.","zh":"不要让僵尸引爆火药桶。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"That's not the scenario we want to see.","zh":"那不是我们想要看到的情况。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Also, is it true that Bloomerangs never miss a catch?","zh":"话说，听说回旋镖射手永远都能接住自己的回旋镖，这是真的吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"KONGFU_8_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"A GIFT for y'all, time travelers!","zh":"送你们份大礼，时间旅行者们！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"These statues are really striking, aren't they?","zh":"这些石像很引人注目不是吗？"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"It took me and my new mate tremendous efforts to bring them here. Hope you'd like'em.","zh":"我和我的新盟友可是费了很大的力气才把它们运过来，希望你们喜欢。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"No, no, no. Hope you'd hate'em.\nDr. Zomboss","zh":"不不不，希望你们不会喜欢。\n——僵尸博士"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"These are really tall statues. Who do they depict?","zh":"这些石像可真高啊，雕刻着的是谁呢？"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"According to my data, powerful Bronze warriors are sealed within these stone statues.","zh":"数据显示这些石像里封印着强大的铜人。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"And what's more, these statues are highly unstable!","zh":"而且这些封印非常不稳定！"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"KONGFU_11_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Bamboo Shoots are skilled to dig beneath the zombies.","zh":"竹笋有一招在僵尸脚底穿梭的绝技。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"It makes them ignored by most zombies.","zh":"这可以让他避开绝大部分僵尸的攻击。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"No wonder these little guys keep themselves short.","zh":"怪不得他一直都不愿意长高。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"KONGFU_12_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Resistant Radish are deep-rooted plants.","zh":"白萝卜的根系非常发达。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"It makes them utterly un-movable facing any external force.","zh":"没有任何东西可以撼动他分毫。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"KONGFU_INTRO_BOSS1":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Good weather today. Right, time travelers?","zh":"今天是个不错的日子，时间旅行者。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Perhaps now is a good time to hold a feast somewhere with a good scenery.","zh":"或许我们可以挑选一个景色秀丽的地方，举办一场宴会。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Perfect timing to introduce my new friend! He's a true hero who can drink a thousand cups without getting drunk!","zh":"正好借此机会认识一下我的新朋友，他可是一位千杯不醉的豪杰。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Of course, no need to purposely look for a site! Your lawn is a perfect one!\nDr. Zomboss","zh":"哦，并没有刻意挑选场地的必要，你的院子就是一个绝佳的地点！\n——僵尸博士"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"High-energy reaction detected!","zh":"检测到高能反应。"},"Animation":"Say_Small","Voice":"winnie/Say_Short"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"It appears our actions here have attracted a rather formidable opponent.","zh":"我们在这里的活动似乎引来了一个实力强劲的对手。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I heard fireworks! Has the feast begun?","zh":"我听到了鞭炮的声音，宴会开始了吗？"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"I don't think that was fireworks.","zh":"我想那并不是鞭炮的声音。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Better get ourselves covered.","zh":"我们最好找个掩体。"},"Animation":"Say_Small","Voice":"winnie/Say_Short"}],"KONGFU_OUTRO_BOSS1":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"It's gone quiet. Is it all clear to come out of the bunker?","zh":"安静下来了，我可以从掩体里出来了吗？"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"We just beat the greatest enemy in Kongfu Temple.","zh":"我们刚刚打倒了寺庙最危险的敌人。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"And what'bout our feast?!","zh":"那我们要举办宴会了吗！？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"We must prepare for a stronger assault immediately.","zh":"我们需要赶快着手应对更猛烈的攻势。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"And no time for a feast.","zh":"而且没有举办宴会的时间。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"What a surprise that you managed to defeat that devil!","zh":"你们能打败那位豪杰真让我意外。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"But this is not the end of our battle.","zh":"不过这场对决还远远没有结束。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"We'll have our day sooner or later.","zh":"我们迟早让你满地找牙。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"}]},"ui":{}}
