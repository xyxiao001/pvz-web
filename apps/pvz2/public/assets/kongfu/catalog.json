/27a7c8ee-cc8f-4ff1-bfef-5a34f3920d00.mp3","kongfu/audio/8329fffd-8d13-4de7-9a3f-f00f1b1a2175.mp3"],"zombossicon/Say_Med":["kongfu/audio/dbc24b85-aea4-44c1-bd70-29f0e79a6cde.mp3","kongfu/audio/16c498f2-e40f-49ef-bffc-3f2623a0f6a8.mp3","kongfu/audio/6b4a7259-035b-42b9-9d89-bdab5cfbcdef.mp3","kongfu/audio/9fa63ae2-17bf-4aec-a693-f21946100110.mp3"],"zombossicon/Say_Long":["kongfu/audio/519753c6-6d42-41cf-acdf-9df6e8c15d01.mp3","kongfu/audio/e3aa0ce3-4771-464a-8e95-dc89529aa792.mp3","kongfu/audio/aaef7c4b-1d6b-4ae5-ba93-795a06b5e1cf.mp3","kongfu/audio/757f97cc-05cc-4d82-9775-a62892ebe0af.mp3"]},"narratives":{"KONGFU_1_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We have arrived in 17th-century of China. All the zombies here are equipped with unique skills.","zh":"我们来到了 17 世纪的中原，这里的僵尸个个都身怀绝技。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Can we find out the secrets of Fortune Cookies here?","zh":"我们能在这找到幸运饼干的秘密吗？"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Fortune Cookies are not from China, User Dave...","zh":"中国并没有幸运饼干，用户戴夫……"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Whoa! There's a weird pattern on the lawn!","zh":"看，地上有个奇怪的图案。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The data indicates that the Tai-Chi tile contains quantities of energy.","zh":"数据显示太极地砖内蕴藏着大量的能量。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Maybe our plants could bring that energy out with there roots!","zh":"或许我们的植物可以用他们的根将这些能量提取出来！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"KONGFU_2_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"There are heat and fire entrenched in Fire Gourds' stomachs.","zh":"火葫芦的腹腔内积蓄着一团火焰。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Seems that they're in high spirits right now!","zh":"这让他看起来情绪高涨。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Tap on Fire Gourds so that they will breathe out the fire.","zh":"点击火葫芦可以让他把这团火焰喷出来，"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The further they charge, the farther they breathe.","zh":"积攒的时间越长，喷得越远。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Let's burn the zombies and all those wooden racks on the lawn down!","zh":"把僵尸和这些堆在草坪上的木架子一并烧成灰吧。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"KONGFU_4_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I just saw A zombie flew-by, somehow...","zh":"我看见有个僵尸从眼前飞了过去，不知怎么地……"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The rockets on Rocket Imps's back push them towards our defenses rapidly.","zh":"火箭小鬼背上的火箭赋予了他们快速冲向我们防线的能力。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"These annoying Imps won't stop until they collide into something.","zh":"不撞到些什么这群烦人的家伙是不会停下来的。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"They're going one way, like a taco to my belly!","zh":"看来他们并没有回头的打算。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"KONGFU_6_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I could smell dynamite.","zh":"空气中弥漫着火药味。"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Don't let the zombies trigger the barrels of dynamite.","zh":"不要让僵尸引爆火药桶。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"That's not the scenario we want to see.","zh":"那不是我们想要看到的情况。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Also, is it true that Bloomerangs never miss a catch?","zh":"话说，听说回旋镖射手永远都能接住自己的回旋镖，这是真的吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"KONGFU_8_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"A GIFT for y'all, time travelers!","zh":"送你们份大礼，时间旅行者们！"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"These statues are really striking, aren't they?","zh":"这些石像很引人注目不是吗？"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"It took me and my new mate tremendous efforts to bring them here. Hope you'd like'em.","zh":"我和我的新盟友可是费了很大的力气才把它们运过来，希望你们喜欢。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"No, no, no. Hope you'd hate'em.\nDr. Zomboss","zh":"不不不，希望你们不会喜欢。\n——僵尸博士"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"These are really tall statues. Who do they depict?","zh":"这些石像可真高啊，雕刻着的是谁呢？"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"According to my data, powerful Bronze warriors are sealed within these stone statues.","zh":"数据显示这些石像里封印着强大的铜人。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"And what's more, these statues are highly unstable!","zh":"而且这些封印非常不稳定！"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"}],"KONGFU_11_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Bamboo Shoots are skilled to dig beneath the zombies.","zh":"竹笋有一招在僵尸脚底穿梭的绝技。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"It makes them ignored by most zombies.","zh":"这可以让他避开绝大部分僵尸的攻击。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"No wonder these little guys keep themselves short.","zh":"怪不得他一直都不愿意长高。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}]},"ui":{}}
