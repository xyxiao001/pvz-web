innie","Action":"SAY","Lines":{"en":"We have arrived in 17th-century of China. All the zombies here are equipped with unique skills.","zh":"我们来到了 17 世纪的中原，这里的僵尸个个都身怀绝技。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Can we find out the secrets of Fortune Cookies here?","zh":"我们能在这找到幸运饼干的秘密吗？"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"Fortune Cookies are not from China, User Dave...","zh":"中国并没有幸运饼干，用户戴夫……"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Whoa! There's a weird pattern on the lawn!","zh":"看，地上有个奇怪的图案。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The data indicates that the Tai-Chi tile contains quantities of energy.","zh":"数据显示太极地砖内蕴藏着大量的能量。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"PLAYFUL","Lines":{"en":"Maybe our plants could bring that energy out with there roots!","zh":"或许我们的植物可以用他们的根将这些能量提取出来！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}]},"ui":{}}
