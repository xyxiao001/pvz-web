-b9ba-483e-a18d-1dd7a243e874.mp3"]},"narratives":{"FUTURE_INTRO_FIRSTLEVEL":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"The Future! Weird, I thought I would be hungrier.","zh":"欢迎来到未来！奇怪，我以为我会变得更饿的。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"After all I haven't eaten in 4000 years!","zh":"毕竟我都 4000 年没吃东西了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"...","zh":"……"},"Animation":"Say_Small","Voice":"winnie/Playful_Short"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Hey, what happened to the lawn? It’s so glowy!","zh":"嘿，我们的草坪怎么回事？到处在发光！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I'm detecting an array of Power Tiles on the space-lawn.","zh":"我检测到这太空草坪上排列好了“超能瓷砖”。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"FUTURE_CHALLENGE_SUNBOMBS_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"You know how sometimes suns are bombs?","zh":"你知道在某些情况下太阳就是炸弹吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"This is one of these times!","zh":"现在就满足那样的情况了喔！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"FUTURE_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I spy with my crazy eye a U.F.B.! An unidentified flying brain!","zh":"我用我疯狂的眼睛探测到了一个 U.F.B.！不明飞行脑！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Something more formidable than a brain lies within.","zh":"比这颗大脑更强大的东西就在其中。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"}]},