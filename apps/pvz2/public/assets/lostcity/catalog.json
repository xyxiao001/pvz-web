audio/e2651a8d-fa65-499b-9211-56d7c4b1dde7.mp3","lostcity/audio/13150ea5-c742-47d9-a6c9-c38b1d532aa3.mp3","lostcity/audio/f0b8c475-13fc-4c2c-b11c-faa9523ab7b6.mp3","lostcity/audio/9f062aec-8464-4b73-bdc2-696c48d54b79.mp3","lostcity/audio/d3064974-a87d-419b-9267-fc1a3d5634e9.mp3","lostcity/audio/578313b7-da5c-448d-8d3d-e3b7a7c0e3c0.mp3","lostcity/audio/142c8a07-8677-41fa-ab72-3cf19ef7b4ae.mp3","lostcity/audio/48d3b1c4-1bae-4bbf-92be-a5186f434b15.mp3"]},"narratives":{"LOSTCITY_1_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Woah! Welcome to the jungle!","zh":"哇！欢迎来到丛林！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"User Dave, this is no ordinary jungle. A scan of my records indicates that this is the fabled Lost City.","zh":"用户戴夫，这并非普通丛林。我的记录扫描显示这是传说中的遗落古城。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Historical texts state that the Sun was worshipped here. Resources should be plentiful.\n","zh":"历史文献记载此地曾崇拜太阳。资源应当极为丰富。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I suggest that we try planting on the Gold Tiles that we find here.","zh":"我建议尝试在发现的黄金地砖上种植。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"They should continuously generate sun as long as they have plants on them.","zh":"只要上面有植物，它们就能持续产生阳光。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Lost City? This is it Penny! We've found it!","zh":"遗落古城？就是这里了潘妮！我们找到了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Where else would I find my lost taco, except in a Lost City?\n","zh":"除了遗落古城，我还能在哪找到丢失的塔可呢？\n"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Your continued fixation defies all logic or reason, User Dave.","zh":"您持续的执念违背所有逻辑与理性，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"LOSTCITY_2_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My sensors indicate movement incoming from above.","zh":"我的传感器检测到上方有物体正在接近。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Maybe it's presents. Presents from the sky!","zh":"也许是礼物。从天而降的礼物！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The chances of that statement being true are statistically irrelevant.\n","zh":"该陈述为真的概率在统计学上可忽略不计。\n"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I believe it to be a new form of zombie threat. We should be cautious of unexpected guests.","zh":"我认为这是一种新型僵尸威胁。我们应当警惕不速之客。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"LOSTCITY_3_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We are facing considerable threats, User Dave. I suggest that we retaliate with tremendous force.","zh":"我们正面临重大威胁，用户戴夫。我建议以绝对力量进行反击。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"More forceful! That's it! We'll give them all a stern talking to.","zh":"更强势些！就这样！我们要给他们来个严肃训话。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I was referring to the Lava Guava. Its explosive blasts leave behind dangerous magma.\n","zh":"我指的是岩浆番石榴。它的爆炸性冲击会留下危险的岩浆。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"That sounds even better! First a stern talking, then some lava!","zh":"这听起来更棒！先严肃训话，再来点岩浆！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}]},"ui":{}}
