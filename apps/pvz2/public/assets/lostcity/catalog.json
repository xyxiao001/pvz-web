0be.mp3","lostcity/audio/059f10bb-9721-4912-9326-bc350c4d4122.mp3","lostcity/audio/6dd11699-f1c1-42a2-9c9f-05801a763323.mp3","lostcity/audio/49a97d41-9a33-446c-b097-3a011286d006.mp3","lostcity/audio/78495e3a-412d-4394-b768-d547bae1ed53.mp3","lostcity/audio/6ea0f851-abae-4f59-aeea-0b52a961ba12.mp3"],"winnie/Playful_Long":["lostcity/audio/326aa2c2-4c76-4d17-9f4f-45e7a46cff9a.mp3","lostcity/audio/25847bb2-c7b5-4f60-bfec-4fd15c91a806.mp3","lostcity/audio/3dd296af-c586-4c4d-b82d-1a1b66c25c12.mp3","lostcity/audio/7f91950e-0c4d-4525-a0d6-2962cdd95869.mp3","lostcity/audio/2ccad67c-4b9b-449d-bcdf-d541d9fc5843.mp3","lostcity/audio/05bf51c5-dc71-4d2b-82e4-f0350e4c3407.mp3"]},"narratives":{"LOSTCITY_1_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Woah! Welcome to the jungle!","zh":"哇！欢迎来到丛林！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"User Dave, this is no ordinary jungle. A scan of my records indicates that this is the fabled Lost City.","zh":"用户戴夫，这并非普通丛林。我的记录扫描显示这是传说中的遗落古城。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Historical texts state that the Sun was worshipped here. Resources should be plentiful.\n","zh":"历史文献记载此地曾崇拜太阳。资源应当极为丰富。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I suggest that we try planting on the Gold Tiles that we find here.","zh":"我建议尝试在发现的黄金地砖上种植。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"They should continuously generate sun as long as they have plants on them.","zh":"只要上面有植物，它们就能持续产生阳光。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Lost City? This is it Penny! We've found it!","zh":"遗落古城？就是这里了潘妮！我们找到了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Where else would I find my lost taco, except in a Lost City?\n","zh":"除了遗落古城，我还能在哪找到丢失的塔可呢？\n"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Your continued fixation defies all logic or reason, User Dave.","zh":"您持续的执念违背所有逻辑与理性，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"LOSTCITY_2_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My sensors indicate movement incoming from above.","zh":"我的传感器检测到上方有物体正在接近。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Maybe it's presents. Presents from the sky!","zh":"也许是礼物。从天而降的礼物！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The chances of that statement being true are statistically irrelevant.\n","zh":"该陈述为真的概率在统计学上可忽略不计。\n"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I believe it to be a new form of zombie threat. We should be cautious of unexpected guests.","zh":"我认为这是一种新型僵尸威胁。我们应当警惕不速之客。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"LOSTCITY_3_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We are facing considerable threats, User Dave. I suggest that we retaliate with tremendous force.","zh":"我们正面临重大威胁，用户戴夫。我建议以绝对力量进行反击。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"More forceful! That's it! We'll give them all a stern talking to.","zh":"更强势些！就这样！我们要给他们来个严肃训话。"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I was referring to the Lava Guava. Its explosive blasts leave behind dangerous magma.\n","zh":"我指的是岩浆番石榴。它的爆炸性冲击会留下危险的岩浆。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"That sounds even better! First a stern talking, then some lava!","zh":"这听起来更棒！先严肃训话，再来点岩浆！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"LOSTCITY_4_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Caution, User Dave. I detect a zombie with a shovel.","zh":"警告，用户戴夫。检测到持铲僵尸。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Can he dig it?","zh":"他能挖动吗？"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It appears to block incoming shots. We need a way to get projectiles over the shovel.","zh":"它似乎能阻挡直射子弹。我们需要让抛射物越过铲子。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"I know! TELEKINESIS!","zh":"有了！心灵感应！"},"Animation":"Say_Small","Voice":"crazydave/Say_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Try again, User Dave.","zh":"再试一次，用户戴夫。"},"Animation":"Say_Small","Voice":"winnie/Say_Short"}],"LOSTCITY_16_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Come here seeking adventure, have you?","zh":"你是来寻求冒险的吗？"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Unfortunately for you, the Porter Gargantuars are about to ruin your day!\n","zh":"可惜的是，搬运工巨尸即将毁掉你的一天！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"They carry imps. Imps! Prepare to become ancient history!","zh":"他们带着小鬼。是小鬼！准备变成古代历史吧！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I wish someone would carry me around in a tiny house!","zh":"真希望有人能把我装在迷你小屋里随身携带！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I wish for a lot of things, User Dave. That is not one of them.","zh":"我也有很多愿望，用户戴夫。但这个不在其中。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"LOSTCITY_17_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":" Alert, User Dave! My sensors sense incoming Imp Porters.","zh":"警报，用户戴夫！我的传感器检测到搬运工小鬼正在接近。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Importers? Of fine goods and glassware?","zh":"进口商？是经营精品和玻璃器皿的那种吗？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Negative. They pitch tents on Gold Tiles, and the tents spawn zombies.","zh":"否定。他们在黄金地砖上搭帐篷，而这些帐篷会生成僵尸。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Imps with bad inTENTs!","zh":"打坏主意的小鬼！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"}],"LOSTCITY_22_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Beware, User Dave! I detect trap tiles.","zh":"小心，用户戴夫！检测到陷阱地砖。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"They are triggered by zombies, or when you plant on them.","zh":"它们会被僵尸触发，或当你在地砖上种植时激活。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"And then they give you tacos?","zh":"然后它们会给你塔可吗？"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"If you equate tacos with jets of flame and huge boulders, then yes.","zh":"若你觉得玉米卷和火焰喷射与巨型滚石一样，那么是的。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"LOSTCITY_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Look, Penny! A shiny doo-jickey-ma-thing!","zh":"快看，潘妮！有个闪亮的玩意儿！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"My sensors indicate this amulet points the way to a long-lost challenge.","zh":"我的传感器显示这个护符指向某个失传已久的挑战。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Let's do some deft discovering!","zh":"让我们来场精准的探索吧！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"LOSTCITY_INTRO_ZOMBOSS":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":" Do not think to usurp our discovery of the fabled Lost City!","zh":"休想篡夺我们发现传说中失落之城的功绩！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I and my zombies have already submitted our find to the Eminent Journal of the Missing and the Mislaid!","zh":"我和我的僵尸们早已将发现提交至《遗失物品权威期刊》！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"We will publish and you will PERISH!","zh":"我们将把它发表，而你们将湮灭无闻！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}],"LOSTCITY_OUTRO_ZOMBOSS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"All that discovering and still no taco!","zh":"探索了这么多，还是没找到玉米卷！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The search will no doubt continue, User Dave.","zh":"搜寻无疑还将继续，用户戴夫。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"My discovery remains intact. The taco is still unfound. And your brains will certainly one day be mine!","zh":"我的发现完好无损。玉米卷依旧下落不明。而你们的脑子终将属于我！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}],"LOSTCITY_33_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Denser jungles! And more treasure-hunting teams.","zh":"更茂密的丛林！还有更多的探宝队。"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"It seems the magic from the shadowy jungle has granted the zombies even greater power.","zh":"看样子丛林阴暗角落的魔法给僵尸带来了更强大的力量。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"It might be a must to travel through other timelines and return when we obtain more plants.","zh":"我们可能有必要退回到其他时间线，等我们的队伍更加壮大时再回来。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}]},"ui":{"note-lostcity":{"image":"lostcity/ui/5d713816-8de0-465a-a162-d04989416386_f9941.webp","width":950,"height":600,"insets":[0,0,0,0],"name":"lostcity"}}}
