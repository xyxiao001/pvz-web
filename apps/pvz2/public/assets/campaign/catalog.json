3"],"boss/worldZombossSummonLoopSound":["campaign/audio/2ea64451-2df2-40ce-851f-8e5562a18355.mp3"],"boss/worldZombossSummonEndSound":["campaign/audio/ce4ae77d-bb5e-4234-ae70-ffde02c8be45.mp3"],"boss/worldZombossEscapeTriggerSound":["campaign/audio/8281f12b-5b47-4b5e-8028-d8c399747feb.mp3"],"boss/worldZombossEscapePortalStartSound":["campaign/audio/4cc9d121-15e8-4b34-bbba-0c7f9463a48e.mp3"],"boss/worldZombossEscapePortalSound":["campaign/audio/fdf29b9c-e616-4277-8469-524b63b00426.mp3"],"boss/worldZombossMechDeathExplodeSound":["campaign/audio/748764a9-d2b6-43f9-bf62-1f0b2d9a5bc0.mp3"],"boss/worldZombossAimStartSound":["campaign/audio/24446c7e-70c5-4dc3-b9c8-8a298dde0e5a.mp3"],"boss/worldZombossMechAimLoopSounds":["campaign/audio/c67d2bde-4441-4c71-b457-e062846af6cc.mp3"],"boss/worldZombossMechPRJDropSounds":["campaign/audio/a99a7eb8-6b22-4257-82a1-ff6009339a24.mp3"],"boss/worldZombossMechShootRiseSounds":["campaign/audio/7e06f902-8d7d-478c-9699-aae1a2e7bfc1.mp3"],"boss/worldZombossMechShootSounds":["campaign/audio/bedf78fb-ea86-4370-9f52-9d68d8795507.mp3"],"boss/introSound":["campaign/audio/305b8d48-3e0e-40ed-b369-3e98863184bb.mp3"],"boss/introStormSound":["campaign/audio/da263011-7732-4798-a0fe-d05efd374cc8.mp3"],"boss/introLandSound":["campaign/audio/ef6ed776-0186-4207-a5a6-d719a6da2e5b.mp3"],"imitater/imitateSound":["campaign/audio/954005d3-9624-4703-84da-67ac4c1f9f66.mp3"],"cherry_bomb/chargeSound":["campaign/audio/05e5d165-a19a-4167-b2b0-90f2537dc791.mp3"]},"narratives":{"EGYPT_CHALLENGE_CONVEYOR_INTRO":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"No need for sun.  Plants are coming via special delivery.","zh":"无需阳光，我们设计了一套植物生产线。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"POWERUPS_TUTORIAL_INITIAL":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"You can cheat in the levels now! You could try them out!","zh":"你获得了作弊功能！赶紧试试怎么使用吧！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SPECIAL6","Lines":{"en":"Yeah, and we can break the seal. Let's get crazy!","zh":"是啊，我们能毫无顾忌地使用它们。让我们狂欢起来吧！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"POWERUPS_TUTORIAL_REPEAT":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"You can try cheating here!","zh":"在这你可以用作弊过关！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"}],"EGYPT_INTRO_GARGANTUAR":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Greetings Temporal Commuters,","zh":"你好啊时空旅行者，"},"Animation":"Idle","Voice":"zombossicon/Say_Short"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Special couriers have been dispatched to retrieve your brains.","zh":"我们已经派出了专门的外交员来取回你的大脑。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Please have your release forms signed before their arrival.","zh":"请在他们抵达前签署好免责声明。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Regards, Dr. Edgar Zomboss.","zh":"致辞，埃德加·僵尸博士。"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Cool, that Mr. Boss guy wants your autograph!","zh":"酷毙了，那位博士先生想要你的签名！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"This can't be good.","zh":"这可不是什么好事啊。"},"Animation":"Say_Small","Voice":"winnie/Playful_Short"}],"EGYPT_OUTRO_GARGANTUAR":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"It looks like a courier had his own delivery to make!","zh":"看样子那位快递员要先把自己的脑袋送回去先了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"This will be useful for traveling to other times.","zh":"这把钥匙将会协助你前往更多地方进行时空旅行。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Yeah! Time to try the Taco Map!","zh":"是啊！是该前往玉米卷时空了！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"EGYPT_CHALLENGE_PRESET_A":[{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"This level is a locked coordinate in time.","zh":"本关是时间线上的一个确切节点。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"You must take these plants to win.","zh":"你必须用选定好的植物取得胜利。"},"Animation":"Say_Medium","Voice":"winnie/Playful_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Otherwise, you risk distorting reality.","zh":"否则你就是在冒险尝试改写历史事实。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Never distort reality! You'll pull something.","zh":"千万不要扭曲历史！会牵引出不好的事物的。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"EGYPT_OUTRO_DANGER_ROOM_KEY":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"Though tetrahedrons are pyramids, this one is not a Platonic solid.","zh":"虽然四面体像金字塔，但它们不是柏拉图立体。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I'm so hungry, I would love a Platonic solid.","zh":"我好饿，给我来一份柏拉图立体吧。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"TIRED","Lines":{"en":"User Dave, this is also not a taco salad.","zh":"戴夫先生，这次的柏拉图立体也不是玉米卷酱料。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"EGYPT_CHALLENGE_PROTECTPLANTS_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"There's a plant call on the banana phone. It's an S.O.S.!","zh":"有株植物用香蕉打了个电话过来。是求救信号！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"They'll be sitting plants if we don't help. Let's take that root and save them!","zh":"如果不保护好他们，时空历史会被改写。快接下任务保护好他们！"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"}],"EGYPT_CHALLENGE_LASTSTAND_A":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"This will be the first last stand. There will be more lasts to come.","zh":"这是我们遭遇的第一场坚不可摧。以后我们可要遭遇到更多的。"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"EGYPT_INTRO_ZOMBOSS":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Have you ever wondered why your neighbor David hungers so?","zh":"你有没有思考过为什么你的邻居戴夫总是如此饥饿？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"What secret ingredient in the taco would drive his desire?","zh":"那个玉米卷里究竟加了什么秘密配方让他如此着迷?"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Could it be that he needs your brains as much as we do?","zh":"和我们对你的大脑的渴求有点太像了不是吗？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"NPC_EXIT"},{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Wha-?! No way. I would never eat a brain taco!","zh":"什么？！不不不可能。我不可能会想吃大脑玉米卷！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"But, I don't remember what was in it...","zh":"但是，我也不是很清楚里面有什么……"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}],"EGYPT_OUTRO_ZOMBOSS":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"PLAYFUL","Lines":{"en":"Wait a minute!","zh":"稍等一下！"},"Animation":"Say_Small","Voice":"crazydave/Playful_Short"},{"Character":"crazydave","Action":"TIRED","Lines":{"en":"There was never any meat in that taco.","zh":"我想起那个玉米卷里没有一块肉。"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I still have Tofunky in my beard to prove it!","zh":"我的胡子里还有玉米卷屑呢，可以拿来证明我的清白！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Well, that just leaves more brains for us... later.","zh":"看样子我们能吃到更多脑子了……以后。"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I'll find you again, in another where and another when!","zh":"我会再找上你们的，无论何时，无论何地！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}],"EGYPT_26_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Murmering mummies! More mummies!","zh":"僵尸们的低吼更加沉重！更多的木乃伊正在来临！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The time fissure is strengthening zombies from all epochs, User Dave.","zh":"时空裂隙正在使来自各个时代的僵尸更加强大，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"We should expect more powerful versions of some zombies.","zh":"我们应该为此做好准备，以应对更强大的僵尸。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"EGYPT_31_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"Hey! Our lawnmowers are a-missing!","zh":"嘿！我们的小推车丢失了！"},"Animation":"Say_Medium","Voice":"crazydave/Say_Med"},{"Character":"winnie","Action":"SAY","Lines":{"en":"The timeline is exhibiting instabilities, User Dave.","zh":"这条时间线已经变得极不稳定了，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Fixed-loop paradoxes are forbidding the presence of lawnmowers.","zh":"莫比乌斯环时空悖论让小推车不再存在了。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"SAY","Lines":{"en":"But I named the middle one \"Mowie\"!","zh":"可我已经给正对家门口的那辆取名“小推”了！"},"Animation":"Say_Long","Voice":"crazydave/Say_Long"}],"EGYPT_35_INTRO":[{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Once more we meet in the sands of time!","zh":"我们又在这满是沙尘的时间线见面了！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Have you enjoyed my new and improved zombies?","zh":"你已经受过我那全新又先进的僵尸大军的洗礼了吧？"},"Animation":"Idle","Voice":"zombossicon/Say_Long"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Or should I say ancient and improved?","zh":"或许我该称之为古老又先进？"},"Animation":"Idle","Voice":"zombossicon/Say_Med"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"Bah! They are nothing to my Zombot Sphinxinator 2.0!","zh":"管他呢！跟我的狮身人面降临者 2.0 相比不值一提！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}],"EGYPT_35_OUTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I'm sweaty! And we did it!","zh":"真是捏了把冷汗！我们做到了！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"},{"Character":"winnie","Action":"EXCITED","Lines":{"en":"We may travel to other timelines freely, User Dave.","zh":"我们接下来可以在其他时间线自由穿梭了，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"But I detect further timeline expansions in the future.","zh":"但我检测到其他时间线也有拓展部分等待我们的修复。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"NPC_EXIT"},{"Character":"winnie","Action":"NPC_EXIT"},{"Character":"zombossicon","Action":"NPC_ENTER"},{"Character":"zombossicon","Action":"SAY","Lines":{"en":"I'll defeat you then, pyramid-iots!","zh":"然后你们就会被我击垮，住金字塔的白痴们！"},"Animation":"Idle","Voice":"zombossicon/Say_Long"}]}}
