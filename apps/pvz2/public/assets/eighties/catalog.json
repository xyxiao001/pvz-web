eighties/audio/9bd3de02-3b49-4230-b17d-c2d0afa88323.mp3"]},"narratives":{"EIGHTIES_1_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"Flashback! I remember this décor from when I chased squirbos as a kid!","zh":"真怀念啊！这布局让我想起小时候追松鼠了！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed, User Dave. We appear to have arrived in the midst of a Neon Mixtape Tour.","zh":"确实如此，用户戴夫。我们似乎误入了炫光魔音游的派对中心。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I suspect the musical tempo may affect the zombies' speeds.","zh":"我怀疑音乐节拍能影响僵尸的速度。"},"Animation":"Say_Medium","Voice":"winnie/Say_Med"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I'm feeding the rhythm, I'M FEEDING THE RHYTHM!","zh":"我在滋养节奏，我在滋养节奏！！"},"Animation":"Say_Medium","Voice":"crazydave/Playful_Med"}],"EIGHTIES_2_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Caution, User Dave.","zh":"小心，用户戴夫。"},"Animation":"Say_Small","Voice":"winnie/Say_Short"},{"Character":"winnie","Action":"SAY","Lines":{"en":"I believe special zombies may display unique abilities while their preferred music is playing.","zh":"我认为特殊僵尸在播放其喜欢的音乐时，可能会展现特殊能力。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"You mean they'll jam their jam when their jam is jamming?","zh":"你是说他们会在即兴狂欢时再来段即兴狂欢？"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Yes, correct, yes, and yes, User Dave.","zh":"正是如此，完全正确，千真万确，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"}],"EIGHTIES_3_INTRO":[{"Character":"crazydave","Action":"NPC_ENTER"},{"Character":"winnie","Action":"NPC_ENTER"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"I got a real Cactus feeling about this, Penny!","zh":"潘妮，我这次有种真切的仙人掌预感！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Indeed, Cactus has changed over time, User Dave.","zh":"确实，经历这么长时间仙人掌也变了，用户戴夫。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"winnie","Action":"SAY","Lines":{"en":"Now she fires a thorn for ranged damage, but hides for ground damage when zombies approach.","zh":"现在她能发射远程尖刺，但僵尸靠近时会缩地规避近战伤害。"},"Animation":"Say_Long","Voice":"winnie/Say_Long"},{"Character":"crazydave","Action":"EXCITED","Lines":{"en":"That's so Cactus... always varying her attack and defensive profiles!","zh":"不愧仙人掌啊……总是转换她的攻防模式！"},"Animation":"Say_Long","Voice":"crazydave/Playful_Long"}]},"ui":{}}
